# Copy to .env only if you are intentionally configuring exchange access.
# Keep withdrawals disabled in exchange key permissions.
SURGE_LIVE_TRADING_ENABLED=false
SURGE_LIVE_TRADING_ARMED=
SURGE_LIVE_EXCHANGE=okx  # okx, binance or coinbaseadvanced
SURGE_LIVE_MAX_ORDER_QUOTE=0
SURGE_BINANCE_API_KEY=
SURGE_BINANCE_API_SECRET=
SURGE_COINBASE_API_KEY=
SURGE_COINBASE_API_SECRET=
# OKX: create the key at okx.com with Read + Trade only (no Withdraw). Use a demo-trading key to test.
SURGE_OKX_API_KEY=
SURGE_OKX_API_SECRET=
SURGE_OKX_API_PASSPHRASE=
