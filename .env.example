# Copy to .env only if you are intentionally configuring exchange access.
# Keep withdrawals disabled in exchange key permissions.
SURGE_LIVE_TRADING_ENABLED=false
SURGE_LIVE_TRADING_ARMED=
SURGE_LIVE_EXCHANGE=okxus  # okxus (primary, US), okx (non-US), binance or coinbaseadvanced
SURGE_LIVE_MAX_ORDER_QUOTE=0
SURGE_BINANCE_API_KEY=
SURGE_BINANCE_API_SECRET=
SURGE_COINBASE_API_KEY=
SURGE_COINBASE_API_SECRET=
# OKX / OKX US: create the key with Read + Trade only (no Withdraw). US accounts use okxus.
# Use a demo-trading key to test.
SURGE_OKX_API_KEY=
SURGE_OKX_API_SECRET=
SURGE_OKX_API_PASSPHRASE=
# Optional data-source keys (python -m data.sources status). Never commit real values.
COINALYZE_API_KEY=
SOSOVALUE_API_KEY=
COINGECKO_API_KEY=
SURGE_SOURCES_INTERVAL=900
