e:14px;line-height:22px">Addresses</span></a></span></li><li class=""><span><a href="/docs/resources/parameters"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Parameters</span></a></span></li><li class=""><span><a href="/docs/resources/access-controls"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Access Controls</span></a></span></li><li class=""><span><a href="/docs/resources/code-licensing"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Code Licensing</span></a></span></li><li class=""><span><a href="/docs/resources/changelog"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Changelog</span></a></span></li><li class=""><span><a href="/docs/resources/risks"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Risks</span></a></span></li><li class=""><span><a href="/docs/resources/web3"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Web3</span></a></span></li><li class=""><span><a href="/docs/resources/glossary"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Glossary</span></a></span></li><li class=""><span><a aria-expanded="false" href="/docs/resources/legacy-versions"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Legacy Versions</span></a><div class="styles_arrowContainer__Gzxkl"><div class="styles_arrow__rpaY4" style="transform:none"><svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.375L4.5 4.875L1 8.375" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div></span><div data-nav-group="closed" style="overflow:hidden;margin-left:-20px;padding-left:20px;opacity:0;height:0px;transform:translateY(-6px)"><ul><li class=""><span><a href="/docs/resources/legacy-versions"><span class="styles_text__zhgFW" style="font-size:14px;line-height:22px">Overview</span