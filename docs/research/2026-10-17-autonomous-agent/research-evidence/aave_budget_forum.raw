in/zero/1.0/","internal":false,"reflection":false,"title":"Deed - CC0 1.0 Universal - Creative Commons","clicks":0},{"url":"https://governance.aave.com/t/direct-to-aip-february-2026-funding-update/24030","internal":true,"reflection":false,"title":"[Direct-to-AIP] February 2026 - Funding Update","clicks":0},{"url":"https://governance.aave.com/t/arfc-horizon-s-rwa-instance/21898","internal":true,"reflection":false,"title":"[ARFC] Horizon’s RWA Instance","clicks":0},{"url":"https://etherscan.io/tx/0x893f41c329d14b2757336eeffe578a81eaf2166907898733ea49cb3245d78bfa","internal":false,"reflection":false,"title":"Ethereum Transaction Hash: 0x893f41c329... | Etherscan","clicks":0},{"url":"https://governance.aave.com/t/arfc-tokenlogic-phase-ii/23223","internal":true,"reflection":false,"title":"[ARFC] TokenLogic - Phase II","clicks":0},{"url":"https://governance.aave.com/t/arfc-safety-module-reduce-emissions/24203","internal":true,"reflection":true,"title":"[ARFC] Safety Module - Reduce Emissions","clicks":0},{"url":"https://governance.aave.com/t/arfc-buyback-program-budget-adjustment/24229","internal":true,"reflection":true,"title":"[ARFC] Buyback Program - Budget Adjustment","clicks":0},{"url":"https://governance.aave.com/t/arfc-stkaave-emissions-update/24945","internal":true,"reflection":true,"title":"[ARFC] stkAAVE Emissions Update","clicks":0}],"read":true,"user_title":"TokenLogic-Finance SP","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":7}],"moderator":true,"admin":true,"staff":true,"user_id":7532,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/1","calendar_details":[],"reactions":[{"id":"heart","type":"emoji","count":7}],"current_user_reaction":null,"reaction_users_count":7,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":62079,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png","created_at":"2026-02-28T18:05:14.117Z","cooked":"\u003cp\u003eThank you for the detailed data analysis.\u003c/p\u003e\n\u003cp\u003eAAVE Labs could easily raise $51 million, but STKAAVE token holder rewards are only around 3.5%, and now they’re going to be reduced to 2%?\u003c/p\u003e\n\u003cp\u003eAre we being too stingy with token holders and too generous with AAVE Labs?\u003c/p\u003e\n\u003cp\u003eIt is recommended to increase STKAAVE rewards to over 10% to incentivize holders to continue holding and locking their AAVE tokens.\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":14,"updated_at":"2026-02-28T18:05:14.117Z","reply_count":2,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":105,"readers_count":104,"score":61.0,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":669,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/2","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62081,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png","created_at":"2026-02-28T18:34:56.728Z","cooked":"\u003cp\u003eStaking AAVE adds precisely zero value, given stkAAVE no longer backs the insurance module. Therefore emissions to stkAAVE should be 0. That money is better spent investing in growth or saving in treasury to have for future initiatives.\u003c/p\u003e\n\u003cp\u003eIn general for DeFi tokens, their value today is mostly in the terminal value - i.e growth trajectory. Therefore investing in growth (which does accrue to token-owned treasury) is highest ROI thing to do for AAVE token. Buy backs and dividends today are suboptimal allocation of resources. Grow net earnings not the dividends.\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":14,"updated_at":"2026-02-28T18:56:27.945Z","reply_count":2,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":3,"reads":104,"readers_count":103,"score":75.8,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":669,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":13877,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/3","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62082,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png","created_at":"2026-02-28T18:54:42.590Z","cooked":"\u003cp\u003eAlso many thanks to TokenLogic for great work here. Much appreciated.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":14,"updated_at":"2026-02-28T18:54:42.590Z","reply_count":0,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":1,"reads":101,"readers_count":100,"score":25.2,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":13877,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":13877,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62083,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png","created_at":"2026-02-28T18:59:06.005Z","cooked":"\u003cp\u003eThis account, registered last December, are you implying that all funds should belong to AAVE Labs?\u003c/p\u003e\n\u003cp\u003eWhy were they able to take $51 million without any basic transparency, KPIs, or accountability, and without even bothering to answer community questions? I haven’t seen you raise any objections.\u003c/p\u003e\n\u003cp\u003eBut you actually think that AAVE holders’ already diminishing 3.5% return should be reduced to zero? Does this mean holders don’t need any returns?\u003c/p\u003e\n\u003cp\u003eDoes this mean that there should be real benefits and KPIs for token holders’ token economics, while AAVE Labs shouldn’t have any requirements at all?\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":14,"updated_at":"2026-02-28T18:59:06.005Z","reply_count":1,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":2,"reads":99,"readers_count":98,"score":94.8,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":13877,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":669,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/5","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62086,"username":"0xmonk","avatar_template":"/user_avatar/governance.aave.com/0xmonk/{size}/9262_2.png","created_at":"2026-03-01T11:21:34.264Z","cooked":"\u003cp\u003eAAVE labs gets 50 mil. service providers gets paid, delegates are rewarded. Almost everyone except AAVE token holders. I’m not clear what is in for the token holders. Wondering how is revenue growth is relevant for them. Just asking.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T11:21:34.264Z","reply_count":1,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":1,"reads":84,"readers_count":83,"score":176.8,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":669,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":8}],"moderator":false,"admin":false,"staff":false,"user_id":12487,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/6","reactions":[{"id":"heart","type":"emoji","count":8}],"current_user_reaction":null,"reaction_users_count":8,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62088,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png","created_at":"2026-03-01T11:51:45.467Z","cooked":"\u003cp\u003e\u003ca class=\"mention\" href=\"/u/0xmonk\"\u003e@0xmonk\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eThe current situatioThe current sThe current situation is that token holders do ncapturvalue of the protocol’s growth.\u003c/p\u003e\n\u003cp\u003e1. Currently, DAO spends $50 million per year to buy back tokens from the market (now reduced to $30 million per year)\u003c/p\u003e\n\u003cp\u003e2. Token holders can stake tokens to earn a risk-free return. Previously, the yield of STKAAVE was around 3.5%, and it is now planned to be further reduced.\u003c/p\u003e\n\u003cp\u003eSince ethlend, every time a token holder wants a certain reward, they are always told that we should invest our money in the development of the project. We are generous with AAVE labs and other service providers, but token holders do not receive any real benefits. AAVE token holders did not benefdid not benefit from the value growth of aave, so the price did not increase significantly.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T11:53:58.693Z","reply_count":1,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":87,"readers_count":86,"score":52.4,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":12487,"username":"0xmonk","avatar_template":"/user_avatar/governance.aave.com/0xmonk/{size}/9262_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":669,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/7","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62089,"username":"0xmonk","avatar_template":"/user_avatar/governance.aave.com/0xmonk/{size}/9262_2.png","created_at":"2026-03-01T12:01:10.602Z","cooked":"\u003col\u003e\n\u003cli\u003eWhat do you think the benefit of buybacks for holders? It may be a good opportunity for traders who used it as their exit liquidity and sold the tokens at 200s and 300s.\u003c/li\u003e\n\u003cli\u003eI don’t think stkAAVE rewards are risk free. They are rewarded for the risk they are taking for safety module. I believe umbrella is rolled out for all markets. I may be wrong here but that’s what I recall.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eAnd why only stkAAVE holders and why not all the AAVE holders\u003c/p\u003e\n\u003cp\u003eJust asking\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T12:04:52.845Z","reply_count":1,"reply_to_post_number":7,"quote_count":0,"incoming_link_count":0,"reads":86,"readers_count":85,"score":22.2,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":669,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":12487,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62090,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png","created_at":"2026-03-01T12:22:34.646Z","cooked":"\u003cp\u003eNow stkaave does not bear any risk . I don’t see any direct benefit to holders of the repurchased tokens, because the repurchased tokens will be distributed to other people, and those people will also sell the tokens.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T12:23:42.104Z","reply_count":0,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":1,"reads":85,"readers_count":84,"score":37.0,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":12487,"username":"0xmonk","avatar_template":"/user_avatar/governance.aave.com/0xmonk/{size}/9262_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":669,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/9","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62092,"username":"okinawajoe","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/o/fbc32d/{size}.png","created_at":"2026-03-01T17:11:36.349Z","cooked":"\u003cp\u003eThank you for the great analysis! Is your estimated full year protocol cash flow -$19M (143M revenue and 164M expenses)?  It seems like a big gap. How should we think about this?\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T17:11:36.349Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":80,"readers_count":79,"score":16.0,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":12773,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/10","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62096,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png","created_at":"2026-03-01T17:42:56.113Z","cooked":"\u003cp\u003eYou misunderstand my message, so let me clarify please. \u003cstrong\u003eAll\u003c/strong\u003e economic value obviously must accrue to and be owned by AAVE token. Nothing else. Also \u003cstrong\u003eall\u003c/strong\u003e investments and spending should absolutely be subject to ROI frameworks, tracking. So we agree on all this.\u003c/p\u003e\n\u003cp\u003eMy point was simply that the overall picture of AAVE token’s intrinsic value is far bigger than a small in-kind dividend (the AAVE “staking yield” you mention) - it’s all the future free cash flow captured by token governed treasury, and therefore, we should be allocating capital with the objective of growing that free cash flow as much as possible, not spending it today to return a tiny dividend to ourselves while rest of the market competes for market share in TAM that’s massively expanding.\u003c/p\u003e","post_number":12,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T17:42:56.113Z","reply_count":1,"reply_to_post_number":5,"quote_count":0,"incoming_link_count":0,"reads":82,"readers_count":81,"score":21.4,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":669,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":13877,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/12","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62098,"username":"DTBAEE","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/d6d6ee/{size}.png","created_at":"2026-03-01T18:09:07.937Z","cooked":"\u003cp\u003e\u003ca class=\"mention\" href=\"/u/jonahskycatcher\"\u003e@JonahSkycatcher\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eEveryone understands these grand principles you’re spouting, so please explain them to AAVE Labs. Why haven’t I seen you saying these things to them? Or are you just an AAVE Labs alt account?\u003c/p\u003e\n\u003cp\u003eYour double standards are blatant: when token holders want a share of Weibo’s profits, you demand that AAVE token holders consider the long-term development of the protocol and the competition. But when AAVE Labs demands $5100, and even forcibly uses its voting rights to pass controversial proposals, I haven’t seen you raise any objections? Stop pretending.\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":14,"updated_at":"2026-03-01T18:10:57.101Z","reply_count":0,"reply_to_post_number":12,"quote_count":0,"incoming_link_count":1,"reads":86,"readers_count":85,"score":22.2,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":13877,"username":"JonahSkycatcher","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/ea666f/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":669,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/13","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62108,"username":"ST0X","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/s/73ab20/{size}.png","created_at":"2026-03-02T05:24:28.972Z","cooked":"\u003cp\u003eIn short, AAVE as protocol is earning good money but substantial amount of the profits are spent on various SPs. SPs is basically split into aave lab and ACI consortium. ACI is controlling the daily ops and spent millions on various incentive program, plus other charges such as SP services fee. AAVE’s annual spending is high as well and do not have detailed breakdown.\u003c/p\u003e\n\u003cp\u003eIn view of this, better to stay as aave LP and not to increase AAVE position until fiscal discipline is there.\u003c/p\u003e","post_number":14,"post_type":1,"posts_count":14,"updated_at":"2026-03-02T05:24:28.972Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":82,"readers_count":81,"score":36.4,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":13021,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/aave-dao-funding-insights/24192/14","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":62369,"username":"CryptoInvest","avatar_template":"/user_avatar/governance.aave.com/cryptoinvest/{size}/1609_2.png","created_at":"2026-03-13T11:02:07.774Z","cooked":"\u003cp\u003eBuying AAve at the market DCA without logic  is wasting capital\u003c/p\u003e\n\u003cp\u003eToken should be purchased when prices are low\u003c/p\u003e\n\u003cp\u003eA mathematical expression could be to purchase when the price is \u0026lt;25 %B bollinger band weekly\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/c/c7810b55a408f49e6f35ae90cb2247da6da003fa.png\" data-download-href=\"/uploads/short-url/ssTuxXioHsRL3d1t8fFITtvpc26.png?dl=1\" title=\"image\" rel=\"noopener nofollow ugc\"\u003e\u003cimg src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/c/c7810b55a408f49e6f35ae90cb2247da6da003fa.png\" alt=\"image\" data-base62-sha1=\"ssTuxXioHsRL3d1t8fFITtvpc26\" width=\"1859\" height=\"869\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eimage\u003c/span\u003e\u003cspan class=\"informations\"\u003e1859×869 90.6 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e\n\u003caside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://charts.cointrader.pro/snapshot/Jj85i\"\u003e\n  \u003cheader class=\"source\"\u003e\n\n      \u003ca href=\"https://charts.cointrader.pro/snapshot/Jj85i\" target=\"_blank\" rel=\"noopener nofollow ugc\"\u003echarts.cointrader.pro\u003c/a\u003e\n  \u003c/header\u003e\n\n  \u003carticle class=\"onebox-body\"\u003e\n    \u003cdiv class=\"aspect-image\" style=\"--aspect-ratio:1878/914;\"\u003e\u003cimg src=\"https://charts.cointrader.pro/snapshot/Jj85i.png\" class=\"thumbnail\" alt=\"\" width=\"1878\" height=\"914\"\u003e\u003c/div\u003e\n\n\u003ch3\u003e\u003ca href=\"https://charts.cointrader.pro/snapshot/Jj85i\" target=\"_blank\" rel=\"noopener nofollow ugc\"\u003eCoinTrader.Pro Chart Viewer - Snapshot\u003c/a\u003e\u003c/h3\u003e\n\n  \u003cp\u003echarts.cointrader.pro allows you to make TradingView charts of all possible cryptocurrencies for free.\u003c/p\u003e\n\n\n  \u003c/article\u003e\n\n  \u003cdiv class=\"onebox-metadata\"\u003e\n    \n    \n  \u003c/div\u003e\n\n  \u003cdiv style=\"clear: both\"\u003e\u003c/div\u003e\n\u003c/aside\u003e\n","post_number":15,"post_type":1,"posts_count":14,"updated_at":"2026-03-13T11:02:07.774Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":58,"readers_count":57,"score":31.6,"yours":false,"topic_id":24192,"topic_slug":"aave-dao-funding-insights","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_i