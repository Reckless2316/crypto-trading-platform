scope="row"><span class="report-table_rowLabel__a_9_N report-table_nestedLabel__srn8A">Growth Costs</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">(0.07)</td><td class="report-table_cell__g2MzQ">(0.07)</td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">New Bets</span></th><td class="report-table_cell__g2MzQ">(0.32)</td><td class="report-table_cell__g2MzQ">(0.59)</td><td class="report-table_cell__g2MzQ">(0.91)</td></tr><tr class="report-table_spacerRow__qWiuV"><td colSpan="4"><span class="report-table_emptyCell__axrlf"></span></td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Shared Services</span></th><td class="report-table_cell__g2MzQ">(1.57)</td><td class="report-table_cell__g2MzQ">(1.58)</td><td class="report-table_cell__g2MzQ">(3.15)</td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">(Foundation Expenses)</span></th><td class="report-table_cell__g2MzQ">(6.92)</td><td class="report-table_cell__g2MzQ">(7.41)</td><td class="report-table_cell__g2MzQ">(14.33)</td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Operating Result before non-recurring items (DAO + Foundations)</span></th><td class="report-table_cell__g2MzQ">1.91</td><td class="report-table_cell__g2MzQ">(0.30)</td><td class="report-table_cell__g2MzQ">1.61</td></tr><tr class="report-table_spacerRow__qWiuV"><td colSpan="4"><span class="report-table_emptyCell__axrlf"></span></td></tr><tr class="report-table_nestedRow__T8TO1"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N report-table_nestedLabel__srn8A">Staking</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td></tr><tr class="report-table_nestedRow__T8TO1"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N report-table_nestedLabel__srn8A">Earn</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">(6.06)</td><td class="report-table_cell__g2MzQ">(6.06)</td></tr><tr class="report-table_nestedRow__T8TO1"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N report-table_nestedLabel__srn8A">New Bets</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td></tr><tr class="report-table_nestedRow__T8TO1"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N report-table_nestedLabel__srn8A">Other</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">0.00</td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">(DAO Expenses - non-recurring)</span></th><td class="report-table_cell__g2MzQ">0.00</td><td class="report-table_cell__g2MzQ">(6.06)</td><td class="report-table_cell__g2MzQ">(6.06)</td></tr><tr class="report-table_spacerRow__qWiuV"><td colSpan="4"><span class="report-table_emptyCell__axrlf"></span></td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Total Results (DAO + Foundations)</span></th><td class="report-table_cell__g2MzQ report-table_positiveCell__AHT4Q">1.91</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(6.36)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(4.45)</td></tr><tr class="report-table_sectionRow__2Wqfr"><th colSpan="4" scope="rowgroup"><span class="report-table_sectionLabel__4nA0E">Product Level PnL Results</span></th></tr><tr class=""><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Staking</span></th><td class="report-table_cell__g2MzQ report-table_positiveCell__AHT4Q">4.25</td><td class="report-table_cell__g2MzQ report-table_positiveCell__AHT4Q">2.48</td><td class="report-table_cell__g2MzQ report-table_positiveCell__AHT4Q">6.73</td></tr><tr class=""><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Earn</span></th><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(0.45)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(6.67)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(7.12)</td></tr><tr class=""><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">New Bets</span></th><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(0.32)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(0.59)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(0.91)</td></tr><tr class="report-table_highlightedRow__o3dIe"><th class="report-table_rowHeader__yDTLX" scope="row"><span class="report-table_rowLabel__a_9_N">Product Results (DAO + Foundations)</span></th><td class="report-table_cell__g2MzQ report-table_positiveCell__AHT4Q">3.48</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(4.78)</td><td class="report-table_cell__g2MzQ report-table_negativeCell__cPTGQ">(1.30)</td></tr></tbody></table></div><p class="ui-typography-body report-table_note__oLzrn">Figures in parentheses are negative.</p></div><h5 class="ui-typography-h5-bold report-blocks_h5__Ch1N0">Treasury Position as of 30 June 2026</h5><div class="re