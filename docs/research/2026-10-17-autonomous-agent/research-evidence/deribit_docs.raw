	payload := strings.NewReader(&quot;{\n  \&quot;jsonrpc\&quot;: \&quot;2.0\&quot;,\n  \&quot;id\&quot;: 9344,\n  \&quot;method\&quot;: \&quot;public/get_book_summary_by_currency\&quot;,\n  \&quot;params\&quot;: {\n    \&quot;currency\&quot;: \&quot;BTC\&quot;,\n    \&quot;kind\&quot;: \&quot;future\&quot;\n  }\n}&quot;)

