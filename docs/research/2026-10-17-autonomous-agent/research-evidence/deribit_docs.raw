/* Non-default rate limits: method name on its own row, metrics underneath. */
.rate-limit-methods {
    margin-top: 0.75rem;
}

.rate-limit-method-labels,
.rate-limit-method-values {
    display: grid;
    grid-template-columns: minmax(4.5rem, 0.7fr) minmax(5rem, 0.9fr) minmax(8rem, 1.4fr) minmax(6rem, 1fr);
    column-gap: 1rem;
    align-items: baseline;
}

.rate-limit-method-labels {
    padding-bottom: 0.35rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    font-size: 0.8125rem;
    font-weight: 600;
}

.rate-limit-method {
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
}

.rate-limit-method:last-child {
    border-bottom: none;
    padding-bottom: 0.15rem;
}

.rate-limit-method-name {
    margin-bottom: 0.3rem;
}

.rate-limit-method-name code {
    white-space: nowrap !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
}

.rate-limit-metric-label {
    display: none;
}

/* Tier table: keep the description column readable without squeezing every table on the site. */
.rate-limit-tiers table {
    table-layout: fixed;
    width: 100%;
}

.rate-limit-tiers th,
.rate-limit-tiers td {
    min-width: 0 !important;
    width: auto !important;
}

.rate-limit-tiers th:nth-child(1),
.rate-limit-tiers td:nth-child(1) {
    width: 11% !important;
}

.rate-limit-tiers th:nth-child(2),
