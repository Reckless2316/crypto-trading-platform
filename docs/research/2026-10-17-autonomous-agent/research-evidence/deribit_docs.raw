x-api/\"]) table td:nth-child(3) {\n    width: 8% !important;\n    min-width: 70px;\n}\n\nbody:has(a[aria-current=\"page\"][href*=\"/fix-api/\"]) table th:nth-child(4),\nbody:has(a[aria-current=\"page\"][href*=\"/fix-api/\"]) table td:nth-child(4) {\n    width: 8% !important;\n    min-width: 70px;\n}\n\nbody:has(a[aria-current=\"page\"][href*=\"/fix-api/\"]) table th:nth-child(5),\nbody:has(a[aria-current=\"page\"][href*=\"/fix-api/\"]) table td:nth-child(5) {\n    width: 66% !important;\n    min-width: 350px;\n}\n\n/* Non-default rate limits: method name on its own row, metrics underneath. */\n.rate-limit-methods {\n    margin-top: 0.75rem;\n}\n\n.rate-limit-method-labels,\n.rate-limit-method-values {\n    display: grid;\n    grid-template-columns: minmax(4.5rem, 0.7fr) minmax(5rem, 0.9fr) minmax(8rem, 1.4fr) minmax(6rem, 1fr);\n    column-gap: 1rem;\n    align-items: baseline;\n}\n\n.rate-limit-method-labels {\n    padding-bottom: 0.35rem;\n    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);\n    font-size: 0.8125rem;\n    font-weight: 600;\n}\n\n.rate-limit-method {\n    padding: 0.7rem 0;\n    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);\n}\n\n.rate-limit-method:last-child {\n    border-bottom: none;\n    padding-bottom: 0.15rem;\n}\n\n.rate-limit-method-name {\n    margin-bottom: 0.3rem;\n}\n\n.rate-limit-method-name code {\n    white-space: nowrap !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n}\n\n.rate-limit-metric-label {\n    display: none;\n}\n\n/* Tier table: keep the description column readable without squeezing every table on the site. */\n.rate-limit-tiers table {\n    table-layout: fixed;\n    width: 100%;\n}\n\n.rate-limit-tiers th,\n.rate-limit-tiers td {\n    min-width: 0 !important;\n    width: auto !important;\n}\n\n.rate-limit-tiers th:nth-child(1),\n.rate-limit-tiers td:nth-child(1) {\n    width: 11% !important;\n}\n\n.rate-limit-tiers th:nth-child(2),\n.rate-limit-tiers td:nth-child(2) {\n    width: 18% !important;\n}\n\n.rate-limit-tiers th:nth-child(3),\n.rate-limit-tiers td:nth-child(3) {\n    width: 18% !important;\n}\n\n.rate-limit-tiers th:nth-child(4),\n.rate-limit-tiers td:nth-child(4) {\n    width: 16% !important;\n}\n\n.rate-limit-tiers th:nth-child(5),\n.rate-limit-tiers td:nth-child(5) {\n    width: 37% !important;\n}\n\n@media (max-width: 640px) {\n    .rate-limit-method-labels {\n        display: none;\n    }\n\n    .rate-limit-method-values {\n        grid-template-columns: 1fr 1fr;\n        row-gap: 0.45rem;\n    }\n\n    .rate-limit-metric-label {\n        display: block;\n        font-size: 0.75rem;\n        font-weight: 600;\n        opacity: 0.7;\n    }\n}\n"])</script><script>self.__next_f.push([1,"62:[\"$\",\"$L67\",null,{\"cssFiles\":[{\"_id\":\"6914d9272754718b161408ea\",\"filePath\":\"public/style.css\",\"subdomain\":\"deribit\",\"__v\":0,\"content\":\"$68\"}]}]\n6a:Tb9a,"])</script><script>self.__next_f.push([1,"// Zamienia \"Query Parameters\" na \"Parameters\"\n(function() {\n    'use strict';\n    \n    function replaceQueryParameters() {\n        try {\n            const headings = document.querySelectorAll('h4.api-section-heading-title');\n            let replaced = 0;\n            \n            headings.forEach(function(heading) {\n                if (heading \u0026\u0026 heading.textContent \u0026\u0026 heading.textContent.trim() === 'Query Parameters') {\n                    heading.textContent = 'Parameters';\n                    replaced++;\n                }\n            });\n            \n            console.log('Replaced', replaced, 'Query Parameters headings');\n        } catch (e) {\n            console.error('Error replacing Query Parameters:', e);\n        }\n    }\n    \n    // Próbuj wielokrotnie\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', replaceQueryParameters);\n    } else {\n        replaceQueryParameters();\n    }\n    \n    window.addEventListener('load', replaceQueryParameters);\n    setTimeout(replaceQueryParameters, 100);\n    setTimeout(replaceQueryParameters, 300);\n    setTimeout(replaceQueryParameters, 500);\n    setTimeout(replaceQueryParameters, 1000);\n    setTimeout(replaceQueryParameters, 2000);\n    \n    // Observer dla dynamicznych zmian\n    if (typeof MutationObserver !== 'undefined') {\n        var observer = new MutationObserver(function() {\n            replaceQueryParameters();\n        });\n        \n        if (document.body) {\n            observer.observe(document.body, {\n                childList: true,\n                subtree: true\n            });\n        } else {\n            setTimeout(function() {\n                if (document.body) {\n                    observer.observe(document.body, {\n                        childList: true,\n                        subtree: true\n                    });\n                }\n            }, 100);\n        }\n    }\n    \n    // Tag Body sections so CSS can hide them precisely\n    function tagBodySections() {\n        try {\n            var sections = document.querySelectorAll('.api-section');\n            sections.forEach(function(section) {\n                var heading = section.querySelector('h4.api-section-heading-title');\n                if (heading \u0026\u0026 heading.textContent \u0026\u0026 heading.textContent.trim().toLowerCase() === 'body') {\n                    section.setAttribute('data-section', 'body');\n                }\n            });\n        } catch (e) {\n            // no-op\n        }\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', tagBodySections);\n    } else {\n        tagBodySections();\n    }\n\n    if (typeof MutationObserver !== 'undefined') {\n        var bodyObserver = new MutationObserver(function() {\n            tagBodySections();\n        });\n        if (document.documentElement) {\n            bodyObserver.observe(document.documentElement, { childList: true, subtree: true });\n        }\n    }\n})();\n\n"])</script><script>self.__next_f.push([1,"63:[\"$\",\"$L69\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6914d9272754718b161408dc\",\"filePath\":\"public/replace-query-params.js\",\"subdomain\":\"deribit\",\"__v\":0,\"content\":\"$6a\"}]}]\n"])</script><script>self.__next_f.push([1,"64:[\"$\",\"$L6b\",null,{\"slug\":\"api-reference/market-data/public-get_book_summary_by_currency\",\"pageMetadata\":\"$45:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L6c\",null,{\"mdxSource\":{\"compiledSource\":\"\\\"use strict\\\";const{Fragment:_Fragment,jsx:_jsx}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){return _jsx(_Fragment,{})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent}\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"public/get_book_summary_by_currency\",\"description\":\"Retrieves the summary information such as open interest, 24h volume, etc. for all instruments for the currency (optionally filtered by kind). **Note** - For real-time updates, we recommend using the WebSocket subscription to `ticker.{instrument_name}.{interval}` instead of polling this endpoint.\",\"deprecated\":null,\"version\":null,\"og:title\":\"public/get_book_summary_by_currency\",\"openapi\":\"specifications/deribit_openapi.json get /public/get_book_summary_by_currency\",\"href\":\"/api-reference/market-data/public-get_book_summary_by_currency\",\"autogeneratedByOpenApi\":true}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.deribit.com\"}]}]\n"])</script></body></html>