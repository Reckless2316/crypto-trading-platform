llection Best Practices](https://docs.deribit.com/articles/options-data-collection-best-practices)\\n\\n[Try in API console](https://test.deribit.com/api_console?method=%2Fpublic%2Fget_book_summary_by_currency)\\n\\n\",\"x-mint\":{\"metadata\":{\"title\":\"public/get_book_summary_by_currency\",\"og:title\":\"public/get_book_summary_by_currency\",\"keywords\":[\"public/get_book_summary_by_currency\",\"currency\",\"kind\",\"instrument_name\",\"high\",\"low\",\"base_currency\",\"quote_currency\",\"volume\",\"bid_price\",\"ask_price\",\"mid_price\",\"mark_price\",\"last\",\"open_interest\",\"creation_timestamp\",\"estimated_delivery_price\",\"volume_usd\",\"volume_notional\",\"current_funding\",\"funding_8h\",\"mark_iv\",\"interest_rate\",\"underlying_index\",\"underlying_price\",\"price_change\"]},\"href\":\"/api-reference/market-data/public-get_book_summary_by_currency\"},\"method\":\"get\",\"type\":\"path\",\"servers\":[\"b47abf1f-caf4-415a-8d6f-fa1d48a10168\"],\"security\":[],\"path\":\"/public/get_book_summary_by_currency\",\"baseUrlOptions\":[\"https://test.deribit.com/api/v2\"],\"title\":\"\",\"codeSamples\":[]},\"dependencies\":{\"parameters\":{\"64e6310b-9c3e-4fae-bfdd-2b098076dfeb\":{\"name\":\"currency\",\"required\":true,\"in\":\"query\",\"schema\":{\"enum\":[\"BTC\",\"ETH\",\"USDC\",\"USDT\",\"EURR\"],\"type\":\"string\",\"description\":\"The currency symbol.\\n\\n**📖 Related Article:** [Using the currency Parameter](https://docs.deribit.com/articles/currency-parameter)\\n\\nCurrency, i.e `\\\"BTC\\\"`, `\\\"ETH\\\"`, `\\\"USDC\\\"`\",\"isRequired\":true,\"uniqueKey\":\"\",\"typeLabel\":\"enum\u003cstring\u003e\"},\"description\":\"The currency symbol.\\n\\n**📖 Related Article:** [Using the currency Parameter](https://docs.deribit.com/articles/currency-parameter)\\n\"},\"a8bee929-d70a-4e86-852f-f4ce8cb35792\":{\"name\":\"kind\",\"required\":false,\"in\":\"query\",\"schema\":{\"enum\":[\"future\",\"option\",\"spot\",\"future_combo\",\"option_combo\"],\"type\":\"string\",\"description\":\"Instrument kind, if not provided instruments of all kinds are considered\\nInstrument kind: `\\\"future\\\"`, `\\\"option\\\"`, `\\\"spot\\\"`, `\\\"future_combo\\\"`, `\\\"option_combo\\\"`\",\"isRequired\":false,\"uniqueKey\":\"\",\"typeLabel\":\"enum\u003cstring\u003e\"},\"description\":\"Instrument kind, if not provided instruments of all kinds are considered\"}},\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"request\":{\"title\":\"request\",\"description\":\"JSON-RPC Request Example\",\"value\":{\"jsonrpc\":\"2.0\",\"id\":9344,\"method\":\"public/get_book_summary_by_currency\",\"params\":{\"currency\":\"BTC\",\"kind\":\"future\"}}}},\"exampleType\":\"examples\"}},\"description\":\"JSON-RPC request body\",\"exampleType\":\"examples\"},\"responses\":{\"07c2c22e-9c27-47f1-8fd6-e3b50ed364e9\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"jsonrpc\":{\"type\":\"string\",\"enum\":[\"2.0\"],\"description\":\"The JSON-RPC version (2.0)\",\"isRequired\":true,\"uniqueKey\":\"jsonrpc\",\"typeLabel\":\"enum\u003cstring\u003e\"},\"result\":{\"type\":\"array\",\"items\":{\"properties\":{\"instrument_name\":{\"example\":\"BTC-PERPETUAL\",\"type\":\"string\",\"description\":\"Unique instrument identifier\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].instrument_name\",\"typeLabel\":\"string\"},\"high\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"Price of the 24h highest trade\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].high\",\"typeLabel\":\"number\"},\"low\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"Price of the 24h lowest trade, `null` if there weren't any trades\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].low\",\"typeLabel\":\"number\"},\"base_currency\":{\"example\":\"ETH\",\"type\":\"string\",\"description\":\"Base currency\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].base_currency\",\"typeLabel\":\"string\"},\"quote_currency\":{\"example\":\"USD\",\"type\":\"string\",\"description\":\"Quote currency\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].quote_currency\",\"typeLabel\":\"string\"},\"volume\":{\"example\":223,\"type\":\"number\",\"description\":\"The total 24h traded volume (in base currency)\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].volume\",\"typeLabel\":\"number\"},\"bid_price\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"The current best bid price, `null` if there aren't any bids\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].bid_price\",\"typeLabel\":\"number\"},\"ask_price\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"The current best ask price, `null` if there aren't any asks\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].ask_price\",\"typeLabel\":\"number\"},\"mid_price\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"The average of the best bid and ask, `null` if there aren't any asks or bids\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].mid_price\",\"typeLabel\":\"number\"},\"mark_price\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"The current instrument market price\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].mark_price\",\"typeLabel\":\"number\"},\"last\":{\"example\":7022.89,\"type\":\"number\",\"description\":\"The price of the latest trade, `null` if there weren't any trades\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].last\",\"typeLabel\":\"number\"},\"open_interest\":{\"example\":0.5,\"type\":\"number\",\"description\":\"Optional (only for derivatives). The total amount of outstanding contracts in the corresponding amount units. For perpetual and inverse futures the amount is in USD units. For options and linear futures it is the underlying base currency coin.\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].open_interest\",\"typeLabel\":\"number\"},\"creation_timestamp\":{\"example\":1536569522277,\"type\":\"integer\",\"description\":\"The timestamp (milliseconds since the Unix epoch)\",\"isRequired\":true,\"uniqueKey\":\"result.items.[INDEX].creation_timestamp\",\"typeLabel\":\"integer\"},\"estimated_delivery_price\":{\"example\":11628.81,\"type\":\"number\",\"description\":\"Optional (only for derivatives). Estimated delivery price for the market.\",\"uniqueKey\":\"result.items.[INDEX].estimated_delivery_price\",\"typeLabel\":\"number\"},\"volume_usd\":{\"type\":\"number\",\"description\":\"Volume in USD\",\"uniqueKey\":\"result.items.[INDEX].volume_usd\",\"typeLabel\":\"number\"},\"volume_notional\":{\"type\":\"number\",\"description\":\"Volume in quote currency (futures and spots only)\",\"uniqueKey\":\"result.items.[INDEX].volume_notional\",\"typeLabel\":\"number\"},\"current_funding\":{\"type\":\"number\",\"example\":0.12344,\"description\":\"Current instantaneous funding rate (perpetual only). Calculated as `(mark_price − index_price) / index_price` at this moment. This is the rate that would apply if a funding settlement occurred right now.\",\"uniqueKey\":\"result.items.[INDEX].current_funding\",\"typeLabel\":\"number\"},\"funding_8h\":{\"type\":\"number\",\"description\":\"Projected 8-hour funding rate for the current settlement window (perpetual only). This is the time-weighted accumulation of the funding rate since the last 8-hour settlement — i.e. the total rate that will be charged or received at the next settlement. `current_funding` shows the instantaneous rate; `funding_8h` shows what has accumulated toward the next settlement.\",\"uniqueKey\":\"result.items.[INDEX].funding_8h\",\"typeLabel\":\"number\"},\"mark_iv\":{\"type\":\"number\",\"description\":\"(Only for option) implied volatility for mark price\",\"uniqueKey\":\"result.items.[INDEX].mark_iv\",\"typeLabel\":\"number\"},\"interest_rate\":{\"example\":0,\"type\":\"number\",\"description\":\"Interest rate used in implied volatility calculations (options only)\",\"uniqueKey\":\"result.items.[INDEX].interest_rate\",\"typeLabel\":\"number\"},\"underlying_index\":{\"example\":\"index_price\",\"type\":\"string\",\"description\":\"Name of the underlying future, or `'index_price'` (options only)\",\"uniqueKey\":\"result.items.[INDEX].underlying_index\",\"typeLabel\":\"string\"},\"underlying_price\":{\"example\":6745.34,\"type\":\"number\",\"description\":\"underlying price for implied volatility calculations (options only)\",\"uniqueKey\":\"result.items.[INDEX].underlying_price\",\"typeLabel\":\"number\"},\"price_change\":{\"example\":10.23,\"type\":\"number\",\"description\":\"24-hour price change expressed as a percentage, `null` if there weren't any trades\",\"uniqueKey\":\"result.items.[INDEX].price_change\",\"typeLabel\":\"number\"}},\"required\":[\"instrument_name\",\"high\",\"low\",\"base_currency\",\"quote_currency\",\"volume\",\"bid_price\",\"ask_price\",\"mid_price\",\"mark_price\",\"last\",\"open_interest\",\"creation_timestamp\"],\"type\":\"object\",\"uniqueKey\":\"result.items.[INDEX]\",\"typeLabel\":\"object\"},\"isRequired\":true,\"uniqueKey\":\"result\",\"typeLabel\":\"object[]\"},\"id\":{\"type\":\"integer\",\"description\":\"The id that was sent in the request\",\"uniqueKey\":\"id\",\"typeLabel\":\"integer\"}},\"required\":[\"result\",\"jsonrpc\"],\"type\":\"object\",\"uniqueKey\":\"\",\"typeLabel\":\"object\"},\"examples\":{\"response\":{\"title\":\"response\",\"description\":\"Response example\",\"value\":{\"jsonrpc\":\"2.0\",\"id\":3659,\"result\":[{\"volume\":0.55,\"underlying_price\":121.38,\"underlying_index\":\"index_price\",\"quote_currency\":\"USD\",\"price_change\":-26.7793594,\"open_interest\":0.55,\"mid_price\":0.2444,\"mark_price\":80,\"low\":0.34,\"last\":0.34,\"interest_rate\":0.207,\"instrument_name\":\"ETH-22FEB19-140-P\",\"high\":0.34,\"creation_timestamp\":1550227952163,\"bid_price\":0.1488,\"base_currency\":\"ETH\",\"ask_price\":0.34}]}}},\"exampleType\":\"examples\"}},\"description\":\"Success response\",\"exa