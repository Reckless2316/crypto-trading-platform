              }
            },
            "ptLoopingFees": {
              "description": "PT-looping service fee earned per epoch in USD, as stored by the sPENDLE epoch job. Already included in `fees` unless a buyback value overrides it; 0 for epochs before PT-looping fees were tracked",
              "type": "array",
