        "GetDistinctUsersFromTokenEntity": {
          "type": "object",
          "properties": {
            "users": {
              "description": "Array of unique wallet addresses (lowercase) that have interacted with the specified token. Addresses are deduplicated across both Sentio and internal data sources.",
              "example": [
                "0x1234567890123456789012345678901234567890",
                "0x0987654321098765432109876543210987654321",
                "0xabcdefabcdefabcdefabcdefabcdefabcdefabcd"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "users"
          ]
        },
        "MoneyMarketResponseDto": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "example": 42161,
              "description": "Chain ID the money market is deployed on."
            },
            "protocol": {
              "type": "string",
              "enum": [
                "Aave",
                "Morpho",
                "Euler",
                "Silo",
                "Contango",
                "Lista"
              ]
            },
            "address": {
              "type": "string",
              "example": "0x72ff0566d069d03b3b7b724cdb17c3bfc5926086"
            },
            "name": {
              "type": "string",
              "example": "Morpho Blue"
            },
            "iconUrl": {
              "type": "string",
              "description": "Absolute URL of the protocol logo."
            },
            "url": {
              "type": "string",
              "description": "Protocol homepage / docs."
            },
            "description": {
              "type": "string"
            },
            "debtAsset": {
              "type": "string",
              "example": "0xaf88d065e77c8cc2239327c5edb3a432268e5831"
            },
            "debtSymbol": {
              "type": "string",
              "example": "USDC",
              "description": "Debt-asset display symbol (via AssetQuerier)."
            },
            "debtDecimals": {
              "type": "number",
              "example": 6,
              "description": "Debt-asset decimals (via AssetQuerier)."
            }
          },
          "required": [
            "chainId",
            "protocol",
            "address",
            "name",
            "iconUrl",
            "url",
            "debtAsset",
            "debtSymbol",
            "debtDecimals"
          ]
        },
        "HealthFactorBandsResponse": {
          "type": "object",
          "properties": {
            "greenMin": {
              "type": "number",
              "description": "Green/yellow boundary and initial slider health factor (fraction)."
            },
            "yellowMin": {
              "type": "number",
              "description": "Yellow/red boundary (fraction)."
            }
          },
          "required": [
            "greenMin",
            "yellowMin"
          ]
        },
        "PtLoopingIncentiveRewardDto": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "example": 1,
              "description": "Chain the reward token lives on."
            },
            "address": {
              "type": "string",
              "example": "0x808507121b80c02388fad14726482e061b8da827",
              "description": "Reward token address, lowercased. PENDLE in practice."
            },
            "amount": {
              "type": "number",
              "description": "Total budget over the whole window, in WHOLE tokens — not raw units, not what has been paid so far. Pairs with `startTimestamp` / `endTimestamp` to read as \"X PENDLE over this window\"."
            }
          },
          "required": [
            "chainId",
            "address",
            "amount"
          ]
        },
        "PtLoopingIncentiveDto": {
          "type": "object",
          "properties": {
            "apy": {
              "type": "number",
              "description": "Extra fixed APY on top of the PT fixed APY (0..1), UNLEVERED. Effective fixed APY = `impliedApy + apy`; effective max looping APY = `maxApy + apy × maxApyLeverage` (`maxApy` itself excludes it)."
            },
            "loopedPt": {
              "type": "number",
              "nullable": true,
              "description": "PT looped into this incentive since it started, in PT TOKENS — the base `apy` was divided by. PT already looped before the campaign opened is excluded. null when it has not been measured yet."
            },
            "capPt": {
              "type": "number",
              "nullable": true,
              "description": "The looped PT this incentive's budget was SIZED for, in PT TOKENS. Same unit as `loopedPt`, so the pair reads as how much of the promised rate is still available. Past it the budget spreads thinner and `apy` decays on its own — nothing is blocked. null when no cap was set."
            },
            "startTimestamp": {
              "type": "number",
              "description": "Unix seconds — when the incentive window opened."
            },
            "endTimestamp": {
              "type": "number",
              "description": "Unix seconds — when the incentive window closes."
            },
            "rewards": {
              "description": "The reward budget funding `apy`, one row per token, for the whole window.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PtLoopingIncentiveRewardDto"
              }
            }
          },
          "required": [
            "apy",
            "loopedPt",
            "capPt",
            "startTimestamp",
            "endTimestamp",
            "rewards"
          ]
        },
        "PtLoopingMmRewardTokenDto": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "example": 1,
              "description": "Chain the reward token lives on."
            },
            "address": {
              "type": "string",
              "example": "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48",
              "description": "Reward token address, lowercased."
            }
          },
          "required": [
            "chainId",
            "address"
          ]
        },
        "PtLoopingMmRewardDto": {
          "type": "object",
          "properties": {
            "side": {
              "type": "string",
              "enum": [
                "borrow",
                "supply"
              ],
              "description": "Which leg of the position the campaign pays."
            },
            "campaignId": {
              "type": "string",
              "description": "Merkl campaign id."
            },
            "name": {
              "type": "string",
              "example": "Borrow USDC from the Aave V4 Main Spoke",
              "description": "Campaign name as the money market publishes it."
            },
            "protocol": {
              "type": "string",
              "example": "Aave",
              "description": "The money market paying the reward."
            },
            "apr": {
              "type": "number",
              "description": "Rate on the borrowed or supplied amount (0..1); excluded from `maxApy` and `borrowApy`."
            },
            "rewardToken": {
              "description": "The token a claim pays out.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PtLoopingMmRewardTokenDto"
                }
              ]
            },
            "startTimestamp": {
              "type": "number",
              "description": "Campaign start, Unix seconds."
            },
            "endTimestamp": {
              "type": "number",
              "description": "Campaign end, Unix seconds."
            }
          },
          "required": [
            "side",
            "campaignId",
            "name",
            "protocol",
            "apr",
            "rewardToken",
            "startTimestamp",
            "endTimestamp"
          ]
        },
        "BorrowRateCurvePointDto": {
          "type": "object",
          "properties": {
            "utilization": {
              "type": "number",
              "description": "Utilization (0..1)."
            },
            "borrowApy": {
              "type": "number",
              "description": "Borrow APY (0..1) at that utilization."
            }
          },
          "required": [
            "utilization",
            "borrowApy"
          ]
        },
        "PtLoopingBoxReferenceDto": {
          "type": "object",
          "properties": {
            "positionUsd": {
              "type": "number",
              "description": "Total position value in USD: the reference size, or the largest the lender can lend."
            },
            "leverage": {
              "type": "number",
              "description": "Leverage at market value (collateral / equity) of the reference position."
            },
            "fixedApy": {
              "type": "number",
              "description": "Fixed APY (0..1) realized by the routed PT fill."
            },
            "borrowApy": {
              "type": "number",
              "description": "6-hour average borrow APY (0..1) after the position borrows."
            }
          },
          "required": [
            "positionUsd",
            "leverage",
            "fixedApy",
            "borrowApy"
          ]
        },
        "PtLoopingBoxDataDto": {
          "type": "object",
          "properties": {
            "minHealthFactor": {
              "type": "number",
              "description": "Minimum relative liquidation headroom used for maxLeverage; 0.03 = 3%. Absent on legacy snapshots."
            },
            "lltv": {
              "type": "number",
              "description": "MM liquidation threshold (0..1)."
            },
            "borrowApy": {
              "type": "number",
              "description": "Trailing 6-hour average pool borrow APY (0..1)."
            },
            "borrowApySpot": {
              "type": "number",
              "nullable": true,
              "description": "Live pool borrow APY (0..1) at snapshot time."
            },
            "borrowApy7dAvg": {
              "type": "number",
              "description": "Trailing 7-day average pool borrow APY (0..1)."
            },
            "maxLeverage": {
              "type": "number",
              "description": "Max safe leverage at the lender LTV cap. Use this for FE sliders."
            },
            "liquidityUsd": {
              "type": "number",
              "nullable": true,
              "description": "Borrowing liquidity a new loop can use (USD), capped by the MM supply headroom."
            },
            "liquidityToTargetUsd": {
              "type": "number",
              "nullable": true,
              "description": "Effective debt liquidity in USD borrowable before the lender reaches target utilization."
            },
            "totalSupplyUsd": {
              "type": "number",
              "nullable": true,
              "description": "Current supplied PT in the MM (USD). Null when not surfaced."
            },
            "supplyCapUsd": {
              "type": "number",
              "nullable": true,
              "description": "MM supply cap (USD). Null for uncapped MMs (e.g. Morpho)."
            },
            "maxApy": {
              "type": "number",
              "nullable": true,
              "description": "Max looping APY before fees at safe-max leverage, from the leverage preview of the reference position."
            },
            "maxApyLeverage": {
              "type": "number",
              "nullable": true,
              "description": "Leverage at market value (collateral / equity) `maxApy` runs on: `maxLeverage` at the collateral market price."
            },
            "collateralYieldApy": {
              "type": "number",
              "nullable": true,
              "description": "Observed vanilla wrapper yield as a decimal fraction, null when unavailable or on PT."
            },
            "collateralYieldObservedAt": {
              "type": "number",
              "nullable": true,
              "description": "Unix seconds of the last vanilla yield observation, null when never observed or on PT."
            },
            "collateralSupplyApy": {
              "type": "number",
              "nullable": true,
              "description": "Vanilla collateral lender supply APY as a decimal fraction, null on PT."
            },
            "ptLoopingIncentive": {
              "nullable": true,
              "description": "The PT fixed-APY extra incentive live on this market. null when none is running.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PtLoopingIncentiveDto"
                }
              ]
            },
            "mmRewards": {
              "description": "Money-market campaigns paying this box’s position.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PtLoopingMmRewardDto"
              }
            },
            "utilization": {
              "type": "number",
              "description": "Debt-reserve utilization (0..1), using the lender's protocol-native denominator."
            },
            "optimalUtilization": {
              "type": "number",
              "description": "Where the lender's borrow-rate curve kinks (0..1)."
            },
            "borrowRateCurve": {
              "description": "The lender's borrow rate against utilization, sampled for plotting. Evaluating it at `utilization` reproduces `borrowApySpot`.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/BorrowRateCurvePointDto"
              }
            },
            "priceImpact": {
              "type": "number",
              "description": "Swap price impact (fraction of routed volume) of the position `maxApy` is priced at."
            },
            "priceImpactAt": {
              "type": "number",
              "description": "Unix seconds — when priceImpact was last quoted."
            },
            "reference": {
              "description": "The position `maxApy` is priced at, when it comes from a leverage preview: `maxApy = fixedApy × leverage − borrowApy × (leverage − 1)`. Absent when `maxApy` is the spot formula.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PtLoopingBoxReferenceDto"
                }
              ]
            },
            "serviceFeeRate": {
              "type": "number",
              "description": "Looping service fee for new intents (fraction of routed volume)."
            },
            "feeRateApy": {
              "type": "number",
              "description": "Entry cost at maxApyLeverage as a yearly rate, linear in leverage and term. Absent when never quoted or inside the last day."
            },
            "snapshottedAt": {
              "type": "number",
              "description": "Unix seconds."
            }
          },
          "required": [
            "lltv",
            "borrowApy",
            "borrowApySpot",
            "borrowApy7dAvg",
            "maxLeverage",
            "liquidityUsd",
            "liquidityToTargetUsd",
            "totalSupplyUsd",
            "supplyCapUsd",
            "maxApy",
            "maxApyLeverage",
            "collateralYieldApy",
            "collateralYieldObservedAt",
            "collateralSupplyApy",
            "ptLoopingIncentive",
            "mmRewards",
            "snapshottedAt"
          ]
        },
        "RiskStatusDto": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "Status text, e.g. 'No Risk', 'Potential Risk', 'Overall Medium Risk'."
