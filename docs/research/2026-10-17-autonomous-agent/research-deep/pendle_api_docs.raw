              "type": "string",
              "description": "Protocol homepage / docs."
            },
            "marketUrl": {
              "type": "string",
              "description": "Lender's page for this specific market. Absent on boxes with no link set; fall back to `url`."
            },
            "assetUrl": {
              "type": "string",
              "description": "The collateral issuer's page, set on vanilla boxes. Absent when no link is set."
            },
            "description": {
              "type": "string"
            },
            "debtAsset": {
              "type": "string",
