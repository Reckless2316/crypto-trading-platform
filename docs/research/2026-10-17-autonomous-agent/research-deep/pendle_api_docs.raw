      "/v1/sdk/{chainId}/limit-order/cancel-all": {
        "get": {
          "description": "Generate the transaction payload to cancel all active limit orders for a user in a single on-chain call.\n\nThis works by incrementing the user's nonce on-chain, which invalidates all previously signed orders at once. More efficient than cancelling orders one by one when clearing all open positions.",
