        "TransactionV5Response": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier of the transaction"
            },
            "market": {
              "type": "string",
              "description": "Market address where the transaction occurred"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string",
              "description": "Timestamp when the transaction occurred"
            },
            "chainId": {
              "type": "number",
              "description": "Chain ID where the transaction occurred"
            },
            "txHash": {
              "type": "string",
              "description": "Transaction hash on the blockchain"
            },
            "value": {
              "type": "number",
              "description": "Transaction value in USD"
            },
            "type": {
              "type": "string",
              "description": "Transaction type (e.g., TRADES, ADD_LIQUIDITY, REMOVE_LIQUIDITY)"
            },
            "action": {
              "type": "string",
              "description": "Transaction action (BUY_PT, SELL_PT, BUY_YT, SELL_YT, LONG_YIELD, SHORT_YIELD, ADD_LIQUIDITY, REMOVE_LIQUIDITY)"
            },
            "txOrigin": {
              "type": "string",
              "description": "Original transaction sender address"
            },
            "isClearAction": {
              "type": "boolean",
              "description": "Whether the user's action is unambiguous."
            },
            "impliedApy": {
              "type": "number",
              "description": "Weighted average implied APY for this transaction"
            },
            "notional": {
              "description": "Notional amounts traded (only for TRADES type)",
              "allOf": [
                {
                  "$ref": "#/components/schemas/NotionalV5"
                }
              ]
            }
          },
          "required": [
            "id",
            "market",
            "timestamp",
            "chainId",
            "txHash",
            "value",
            "type",
            "action",
            "isClearAction",
            "impliedApy"
          ]
        },
        "TransactionsV5Response": {
          "type": "object",
          "properties": {
            "total": {
              "type": "number",
              "description": "Total number of transactions available"
            },
            "resumeToken": {
              "type": "string",
              "description": "Resume token for pagination. Use this to continue a previous query. Use this token in the next request. Can be undefined if the query is at the end of the results."
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of results returned"
            },
            "skip": {
              "type": "number",
              "description": "Number of results skipped for pagination"
            },
            "results": {
              "description": "List of transactions",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TransactionV5Response"
              }
            }
          },
          "required": [
            "total",
            "limit",
            "skip",
            "results"
          ]
        },
        "DynamicIncentiveCampaignEntity": {
          "type": "object",
          "properties": {
            "marketId": {
              "type": "string",
              "example": "42161-0x6b92feb89ed16aa971b096e247fe234db4aaa262"
            },
            "chainId": {
              "type": "number",
              "example": 42161
            },
            "marketAddress": {
              "type": "string",
              "example": "0x6b92feb89ed16aa971b096e247fe234db4aaa262"
            },
            "rewardToken": {
              "type": "string",
              "nullable": true,
              "description": "Reward token address, on the market chain."
            },
            "startTs": {
              "type": "number",
              "description": "Campaign start, unix seconds."
            },
            "endTs": {
              "type": "number",
              "description": "Campaign end (the market expiry), unix seconds."
            },
            "ytRewardApr": {
              "type": "number",
              "description": "Live YT reward APR as a fraction (0.02 = 2%); 0 when none."
            },
            "ptRewardApr": {
              "type": "number",
              "description": "Live PT reward APR as a fraction; 0 when none."
            },
            "budgetTokens": {
              "type": "number",
              "nullable": true,
              "description": "Total reward tokens the campaign pays at its cap, in token units (not wei)."
            },
            "tvlCapSy": {
              "type": "number",
              "nullable": true,
              "description": "Funded TVL cap, in SY units."
            },
            "liveTvlSy": {
              "type": "number",
              "nullable": true,
              "description": "Live SY supply, in SY units."
            }
          },
          "required": [
            "marketId",
            "chainId",
            "marketAddress",
            "rewardToken",
            "startTs",
            "endTs",
            "ytRewardApr",
            "ptRewardApr",
            "budgetTokens",
            "tvlCapSy",
            "liveTvlSy"
          ]
        },
        "DynamicIncentiveCampaignsResponse": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/DynamicIncentiveCampaignEntity"
              }
            }
          },
          "required": [
            "results"
          ]
        },
        "PtLoopingBoxVolumeEntity": {
          "type": "object",
          "properties": {
            "boxId": {
              "type": "string",
              "description": "bytes32 BoxData hash."
            },
            "chainId": {
              "type": "number",
              "example": 42161
            },
            "ptMarketAddress": {
              "type": "string",
              "nullable": true,
              "description": "Same value as `ptMarketAddress` on `loop/boxes`."
            },
            "ptMarketName": {
              "type": "string",
              "nullable": true,
              "example": "PT-USDe 2026May"
            },
            "ptAddress": {
              "type": "string"
            },
            "ptSymbol": {
              "type": "string",
              "nullable": true,
              "example": "PT-USDe-25DEC2025"
            },
            "protocol": {
              "type": "string",
              "example": "MORPHO"
            },
            "moneyMarketAddress": {
              "type": "string"
            },
            "moneyMarketName": {
              "type": "string",
              "example": "Morpho Blue"
            },
            "debtAsset": {
              "type": "string"
            },
            "debtSymbol": {
              "type": "string",
              "example": "USDC"
            },
            "buyVolumeUsd": {
              "type": "number",
              "description": "USD routed in on increase (buy) iterations."
            },
            "sellVolumeUsd": {
              "type": "number",
              "description": "USD routed out on decrease (sell) iterations."
            },
            "totalVolumeUsd": {
              "type": "number"
            },
            "positionCount": {
              "type": "number",
              "description": "Distinct positions (owner, box) with volume in the window."
            },
            "lastActiveTs": {
              "type": "number",
              "nullable": true,
              "description": "Unix seconds of the latest in-window iteration."
            }
          },
          "required": [
            "boxId",
            "chainId",
            "ptMarketAddress",
            "ptMarketName",
            "ptAddress",
            "ptSymbol",
            "protocol",
            "moneyMarketAddress",
            "moneyMarketName",
            "debtAsset",
            "debtSymbol",
            "buyVolumeUsd",
            "sellVolumeUsd",
            "totalVolumeUsd",
            "positionCount",
            "lastActiveTs"
          ]
        },
        "PtLoopingVolumeResponse": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "enum": [
                "7d",
                "30d",
                "all"
              ]
            },
            "timestampStart": {
              "type": "number",
              "nullable": true,
              "description": "Window start, unix seconds (inclusive); null for `all`."
            },
            "timestampEnd": {
              "type": "number"
            },
            "results": {
              "description": "Sorted by `totalVolumeUsd` descending.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PtLoopingBoxVolumeEntity"
              }
            }
          },
          "required": [
            "period",
            "timestampStart",
            "timestampEnd",
            "results"
          ]
        },
        "TradeMixSizeEntity": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "enum": [
                "lt1k",
                "1k-10k",
                "10k-100k",
                "gte100k"
              ],
              "description": "USD size bucket, lower bound inclusive"
            },
            "count": {
              "type": "number"
            },
            "volumeUsd": {
              "type": "number",
              "description": "Summed USD valuation of these trades; unvalued trades count as 0"
            }
          },
          "required": [
            "bucket",
            "count",
            "volumeUsd"
          ]
        },
        "TradeMixChainEntity": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number"
            },
            "count": {
              "type": "number"
            },
            "volumeUsd": {
              "type": "number",
              "description": "Summed USD valuation of these trades; unvalued trades count as 0"
            }
          },
          "required": [
            "chainId",
            "count",
            "volumeUsd"
          ]
        },
        "TradeMixActionEntity": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "example": "SWAP_PT"
            },
            "count": {
              "type": "number"
            },
            "volumeUsd": {
              "type": "number",
              "description": "Summed USD valuation of these trades; unvalued trades count as 0"
            }
          },
          "required": [
            "action",
            "count",
            "volumeUsd"
          ]
        },
        "TradeMixResponse": {
          "type": "object",
          "properties": {
            "timestampStart": {
              "type": "number",
              "description": "Unix seconds, inclusive: UTC midnight 7 days before timestampEnd"
            },
            "timestampEnd": {
              "type": "number",
              "description": "Unix seconds, exclusive: most recent UTC midnight"
            },
            "total": {
              "type": "number"
            },
            "totalVolumeUsd": {
              "type": "number",
              "description": "Summed USD valuation of every trade in the window; unvalued trades count as 0"
            },
            "bySize": {
              "description": "Always all four buckets, in ascending size order",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TradeMixSizeEntity"
              }
            },
            "byChain": {
              "description": "Count descending",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TradeMixChainEntity"
              }
            },
            "byAction": {
              "description": "Count descending",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TradeMixActionEntity"
              }
            }
          },
          "required": [
            "timestampStart",
            "timestampEnd",
            "total",
            "totalVolumeUsd",
            "bySize",
            "byChain",
            "byAction"
          ]
        },
        "MarketFeeRowResponse": {
          "type": "object",
          "properties": {
            "explicitSwapFeeUsd": {
              "type": "number",
              "description": "Explicit AMM swap fee (USD)"
            },
            "implicitSwapFeeUsd": {
              "type": "number",
              "description": "Implicit swap fee carried in the rate (USD)"
            },
            "limitOrderFeeUsd": {
              "type": "number",
              "description": "Limit-order fee (USD)"
            },
            "poolFeeUsd": {
              "type": "number",
              "description": "Everything the pool charged: sum of the stored daily `totalPoolFeeInUsd`"
            },
            "protocolFeeUsd": {
              "type": "number",
              "description": "Treasury cut of the pool fee: sum of the stored daily `totalTreasuryFeeInUsd`"
            },
            "lpFeeUsd": {
              "type": "number",
              "description": "poolFeeUsd - protocolFeeUsd, floored at 0"
            },
            "realizedYtFeeUsd": {
              "type": "number",
              "description": "YT fee (interest + rewards) realized in the epoch by the market YT"
            }
          },
          "required": [
            "explicitSwapFeeUsd",
            "implicitSwapFeeUsd",
            "limitOrderFeeUsd",
            "poolFeeUsd",
            "protocolFeeUsd",
            "lpFeeUsd",
            "realizedYtFeeUsd"
          ]
        },
        "MarketFeesMarketResponse": {
          "type": "object",
          "properties": {
            "explicitSwapFeeUsd": {
              "type": "number",
              "description": "Explicit AMM swap fee (USD)"
            },
            "implicitSwapFeeUsd": {
              "type": "number",
              "description": "Implicit swap fee carried in the rate (USD)"
            },
            "limitOrderFeeUsd": {
              "type": "number",
              "description": "Limit-order fee (USD)"
            },
            "poolFeeUsd": {
              "type": "number",
              "description": "Everything the pool charged: sum of the stored daily `totalPoolFeeInUsd`"
            },
            "protocolFeeUsd": {
              "type": "number",
              "description": "Treasury cut of the pool fee: sum of the stored daily `totalTreasuryFeeInUsd`"
            },
            "lpFeeUsd": {
              "type": "number",
              "description": "poolFeeUsd - protocolFeeUsd, floored at 0"
            },
            "realizedYtFeeUsd": {
              "type": "number",
              "description": "YT fee (interest + rewards) realized in the epoch by the market YT"
            },
            "marketId": {
              "type": "string",
              "example": "1-0x...",
              "description": "`chainId-address`"
            },
            "chainId": {
              "type": "number"
            },
            "address": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "expiry": {
              "type": "string",
              "description": "ISO date"
            }
          },
          "required": [
