              "type": "number",
              "description": "Leverage multiple."
            },
            "healthFactor": {
              "type": "number",
              "description": "Position health: 1.0 (100%) healthy down to 0 at liquidation. max(0, 1 - LTV/LLTV)."
            },
            "loopingApy": {
              "type": "number",
              "nullable": true,
              "description": "Looping APY at this state."
            },
            "equityUsd": {
              "type": "number",
              "nullable": true,
