            "expectedTokenOut": {
              "type": "string",
              "description": "SELL: raw debt out; SWEEP: raw output out; \"0\" on BUY."
            },
            "debtRepaid": {
              "type": "string",
              "description": "SELL: raw debt repaid; \"0\" otherwise."
            }
          },
          "required": [
            "inputAmount",
            "expectedPtOut",
            "borrowAmount",
            "expectedTokenOut",
            "debtRepaid"
          ]
        },
        "LoopStepActualDto": {
          "type": "object",
          "properties": {
            "txHash": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "revert"
              ]
            },
            "amountIn": {
              "type": "string"
            },
            "amountOut": {
              "type": "string"
            },
            "borrowedAmount": {
              "type": "string",
              "description": "BUY iters: debt borrowed."
            },
            "repaidAmount": {
              "type": "string",
              "description": "SELL iters: debt repaid."
            },
            "executedRate": {
              "type": "string",
              "description": "Actual executed swap rate (FixedX18 WAD)."
            }
          }
        },
        "LoopStepDto": {
          "type": "object",
          "properties": {
            "displayIndex": {
              "type": "number",
              "description": "1-based display position across the whole step list."
            },
            "kind": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopIterationKind"
                }
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "done",
                "running",
                "pending",
                "not-needed"
              ],
              "description": "Render state."
            },
            "source": {
              "type": "string",
              "enum": [
                "actual",
                "projected"
              ]
            },
            "inputAssetKind": {
              "description": "Asset this step consumes. Absent only on a sweep row with no projected counterpart.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopIterationInputKind"
                }
              ]
            },
            "debtClearedAfter": {
              "type": "boolean",
              "description": "SELL: render the \"Debt fully repaid\" boundary after this row."
            },
            "est": {
              "nullable": true,
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopStepEstDto"
                }
              ]
            },
            "actual": {
              "nullable": true,
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopStepActualDto"
                }
              ]
            }
          },
          "required": [
            "displayIndex",
            "kind",
            "state",
            "source",
            "debtClearedAfter"
          ]
        },
        "LeverageIntentDetailDto": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IntentTypeIncreaseSc"
                }
              ]
            },
            "actionType": {
              "description": "Derived action label. Disambiguates the IntentTypes that map to two actions: INCREASE_SC -> `deposit`/`increase_lev`, DECREASE_SC -> `partial_withdraw`/`decrease_leverage`.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopingActionType"
                }
              ]
            },
            "chainId": {
              "type": "number"
            },
            "owner": {
              "type": "string",
              "description": "User wallet (BoxPermit owner)."
            },
            "box": {
              "type": "string",
              "description": "CREATE2-derived LoopPositionBox address."
            },
            "boxId": {
              "type": "string",
              "description": "On-chain box identifier (bytes32 hex)."
            },
            "pt": {
              "type": "string",
              "description": "PT collateral address."
            },
            "debtToken": {
              "type": "string",
              "description": "Borrow / debt token address."
            },
            "status": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IntentStatus"
                }
              ]
            },
            "currentIteration": {
              "type": "number",
              "description": "Number of iterations executed so far."
            },
            "iterations": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/IntentIterationDto"
              }
            },
            "lastTxHash": {
              "type": "string"
            },
            "runId": {
              "type": "string",
              "description": "Temporal runId pinned to this intent."
            },
            "errorCode": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IntentErrorCode"
                }
              ]
            },
            "dustDebtRaw": {
              "type": "string",
              "description": "Dust thresholds (raw bigint strings)."
            },
            "dustPtRaw": {
              "type": "string"
            },
            "dustInputRaw": {
              "type": "string",
              "description": "Set on flows with an inputToken/outputToken."
            },
            "startMmPt": {
              "type": "string",
              "description": "MM PT balance at intent creation (raw)."
            },
            "startMmDebt": {
              "type": "string",
              "description": "MM debt balance at intent creation (raw)."
            },
            "terminalBoxDebt": {
              "type": "string",
              "description": "Box balance at terminal time, in `terminalBoxToken`, when the intent ends with `COMPLETED_WITH_RESIDUAL` (or FAILED with leftover funds). Empty otherwise. Used by the FE to surface \"X stuck in box, run a withdraw to sweep\"."
            },
            "terminalBoxToken": {
              "type": "string",
              "description": "Token of `terminalBoxDebt`."
            },
            "equityFlowUsd": {
              "type": "number",
              "description": "Signed USD value of equity moved by this intent at action time. Drives the FE Initial Capital aggregator."
            },
            "createdAt": {
              "format": "date-time",
              "type": "string"
            },
            "updatedAt": {
              "format": "date-time",
              "type": "string"
            },
            "progress": {
              "type": "number",
              "description": "Single 0..1 progress number for the FE bar. Per-action formula: PT-grow toward `targetMinPt` for INCREASE/ADD_COLLATERAL, debt-drain toward `effectiveTargetMaxDebt` for DECREASE, status-derived for REPAY, BORROW_OUT and WITHDRAW. Backend computes per request from a frozen start snapshot + live MM read."
            },
            "estDurationSeconds": {
              "type": "number",
              "description": "Static rough ETA for the action, in seconds. Chain-aware (reads viem block time) × per-action iter count + workflow overhead. Render as \"est. ~X min\" — NOT precise; the actual run can exceed it on slow blocks / aggregator retries."
            },
            "secondsRemaining": {
              "type": "number",
              "nullable": true,
              "description": "Live countdown in seconds for the FE. `max(0, estDurationSeconds − elapsedSinceStart)`. `null` when there's nothing to count down (pre-execution / terminal). Hits `0` while still EXECUTING means the workflow is taking longer than estimated — render \"wrapping up…\" rather than panic."
            },
            "aggregators": {
              "type": "array",
              "description": "Aggregator subset chosen at sign time; workflow per-iter quotes use exactly this set.",
              "items": {
                "type": "string",
                "enum": [
                  "KYBERSWAP",
                  "OKX",
                  "PARASWAP"
                ]
              }
            },
            "simulateOutput": {
              "description": "Preview snapshot supplied at intent creation; absent on WITHDRAW_SC.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LoopSimulateOutputDto"
                }
              ]
            },
            "projections": {
              "description": "Raw projected step list (merge input). Prefer `steps` for rendering.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LoopIterationProjection"
              }
            },
            "steps": {
              "description": "Server-merged live-execution step list (projected estimate + actual folded in, bucketed by kind). Render verbatim — no client-side merge.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LoopStepDto"
              }
            },
            "targetMinPt": {
              "type": "string"
            },
            "inputToken": {
              "type": "string",
              "description": "Deposit-flow trio (open-position). Absent on lever-up."
            },
            "inputAmount": {
              "type": "string",
              "description": "Deposit-flow trio (open-position). Absent on lever-up."
            },
            "quotedDebtAmount": {
              "type": "string",
              "description": "FE's aggregator-quoted debt-token amount expected to land in the box after the pre-swap (raw debt-token units). Deposit-flow trio (open-position). Absent on lever-up."
            },
            "requestExpiry": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "actionType",
            "chainId",
            "owner",
            "box",
            "boxId",
            "pt",
            "debtToken",
            "status",
            "currentIteration",
            "iterations",
            "dustDebtRaw",
            "dustPtRaw",
            "startMmPt",
            "startMmDebt",
            "createdAt",
            "updatedAt",
            "progress",
            "estDurationSeconds",
            "secondsRemaining",
            "aggregators",
            "projections",
            "steps",
            "targetMinPt",
            "requestExpiry"
          ]
        },
