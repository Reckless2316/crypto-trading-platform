                  "$ref": "#/components/schemas/RiskStatusDto"
                }
              ]
            },
            "summary": {
              "type": "string",
              "description": "One-line summary shown on the collapsed row."
            },
            "detail": {
              "description": "Expanded detail; absent on rows without oracle detail.",
