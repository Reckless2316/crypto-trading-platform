        "IntentType": {
          "type": "string",
          "enum": [
            "INCREASE_SC",
            "DECREASE_SC",
            "ADD_COLLATERAL_SC",
            "REPAY_SC",
            "BORROW_OUT_SC",
            "WITHDRAW_SC"
          ]
        },
        "ActiveIntentDto": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IntentType"
                }
              ]
            },
            "status": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/IntentStatus"
                }
              ]
            },
            "createdAt": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "status",
            "createdAt"
          ]
        },
        "PositionChainStateDto": {
          "type": "object",
          "properties": {
            "collateralRaw": {
              "type": "string",
              "description": "PT collateral held in the money market (raw units)."
            },
            "debtRaw": {
              "type": "string",
              "description": "Outstanding debt in the money market (raw units)."
            },
            "ptInBoxRaw": {
              "type": "string",
              "description": "Free PT sitting in the box awaiting action (raw units)."
            },
            "debtInBoxRaw": {
              "type": "string",
              "description": "Free debt-token sitting in the box awaiting action (raw units)."
            },
            "quotedAt": {
              "type": "number",
              "description": "Unix timestamp in seconds of this live read."
            }
          },
          "required": [
            "collateralRaw",
            "debtRaw",
            "ptInBoxRaw",
            "debtInBoxRaw",
            "quotedAt"
          ]
        },
        "PositionPricingDto": {
          "type": "object",
          "properties": {
            "priceRawDebtPerPtWad": {
              "type": "string",
              "description": "Raw-to-raw WAD: `(debtIn * 1e18) / ptOut` — drops directly onto the contract math."
            },
            "pricePerPtWholeWad": {
              "type": "string",
              "description": "Whole-to-whole WAD: human-readable \"how many debt tokens per PT, scaled 1e18\"."
            },
            "ptDecimals": {
              "type": "number"
            },
            "debtDecimals": {
              "type": "number"
            }
          },
          "required": [
            "priceRawDebtPerPtWad",
            "pricePerPtWholeWad",
            "ptDecimals",
            "debtDecimals"
          ]
        },
        "PositionValuationDto": {
          "type": "object",
          "properties": {
            "collateralValueUsd": {
              "type": "number",
              "description": "Collateral value (PT × live price × debt-token USD), dollars."
            },
            "debtValueUsd": {
              "type": "number",
              "description": "Outstanding debt value in dollars."
            },
            "netValueUsd": {
              "type": "number",
              "description": "Net position value (collateral − debt), dollars."
            },
            "netValueInDebt": {
              "type": "string",
              "description": "Net position value in raw debt-token units (bigint string). Powers Underlying-mode display."
            },
            "ptPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "USD price per PT at quote time, null when debt token has no Pendle price feed."
            },
            "debtPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "USD price per debt token at quote time."
            }
          },
          "required": [
            "collateralValueUsd",
            "debtValueUsd",
            "netValueUsd",
            "netValueInDebt",
            "ptPriceUsd",
            "debtPriceUsd"
          ]
        },
        "PositionLeverageDto": {
          "type": "object",
          "properties": {
            "currentLtvWad": {
              "type": "string",
              "description": "Current LTV scaled 1e18 (= debtValue / collateralValue, WAD)."
            },
            "currentLtv": {
              "type": "number",
              "description": "Decimal LTV (0..1) — convenience for UI; may lose precision."
            },
            "currentLeverage": {
              "type": "number",
              "description": "Current leverage multiple = 1 / (1 − currentLtv). ≥1 always."
            }
          },
          "required": [
            "currentLtvWad",
            "currentLtv",
            "currentLeverage"
          ]
        },
        "PositionApyDto": {
          "type": "object",
          "properties": {
            "borrowApy": {
              "type": "number",
              "nullable": true,
              "description": "Trailing 6-hour-average MM borrow APY (0..1)."
            },
            "avgFixedApy": {
              "type": "number",
              "nullable": true,
              "description": "Weighted-avg fixed APY of currently-held PT."
            },
            "currentLoopingApy": {
              "type": "number",
              "nullable": true,
              "description": "Pre-fee looping APY: collateral APY × L − borrowApy × (L − 1), L = apyLeverage."
            },
            "apyLeverage": {
              "type": "number",
              "description": "Leverage at market value (collateral / equity) the looping APY uses."
            },
            "breakevenBorrowApy": {
              "type": "number",
              "nullable": true,
              "description": "Borrow APY that zeros out leveraged returns."
            },
            "collateralYieldApy": {
              "type": "number",
              "nullable": true,
              "description": "Observed vanilla collateral yield as a decimal fraction, null when unavailable or on PT."
            },
            "collateralYieldObservedAt": {
              "type": "number",
              "nullable": true,
              "description": "Unix seconds of the last vanilla yield write, including null results; null before the first write or on PT."
            },
            "collateralSupplyApy": {
              "type": "number",
              "nullable": true,
              "description": "Vanilla lender supply APY as a decimal fraction, using the returned view rate; null without a rate or on PT."
            }
          },
          "required": [
            "borrowApy",
            "avgFixedApy",
            "currentLoopingApy",
            "apyLeverage",
            "breakevenBorrowApy",
            "collateralYieldApy",
            "collateralYieldObservedAt",
            "collateralSupplyApy"
          ]
        },
        "PositionLiquidationThresholdDto": {
          "type": "object",
          "properties": {
            "liquidationLtv": {
              "type": "number",
              "description": "LLTV (0..1) — liquidation threshold set by the MM."
            },
            "liquidationPtPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "PT USD price that trips liquidation."
            },
            "liquidationUnderlyingPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "Underlying-asset USD price that trips liquidation."
            }
          },
          "required": [
            "liquidationLtv",
            "liquidationPtPriceUsd",
            "liquidationUnderlyingPriceUsd"
          ]
        },
        "PositionEquityDto": {
          "type": "object",
          "properties": {
            "initialCapitalUsd": {
              "type": "number",
              "nullable": true,
              "description": "FE 'Est. Initial Capital'. Net USD value the user has deposited into this box across its intent history. v1 sums INCREASE_SC + ADD_COLLATERAL_SC + REPAY_SC inputs at current input-token USD price (stable approximation per the FE annotation rule #2). A BORROW_OUT_SC draw is not user capital, so it adds nothing here; the equity it takes out is realised on the sweep. Withdrawal-side subtraction is not yet wired — the engine doesn't persist realized output amounts on terminal. Null when an input token has no USD price."
            },
            "initialCapitalInDebt": {
              "type": "string",
              "nullable": true,
              "description": "Same as `initialCapitalUsd` but in debt-token raw units (bigint string). Powers the FE's Underlying-mode display. Null when no Initiate has folded yet."
            }
          },
          "required": [
            "initialCapitalUsd",
            "initialCapitalInDebt"
          ]
        },
        "PositionEpochDto": {
          "type": "object",
          "properties": {
            "openedAt": {
              "type": "number",
              "nullable": true,
              "description": "Unix seconds when the current position epoch opened."
            },
            "lastClosedAt": {
              "type": "number",
              "nullable": true,
              "description": "Unix seconds when the most recent epoch closed."
            }
          },
          "required": [
            "openedAt",
            "lastClosedAt"
          ]
        },
        "PositionPtIncentiveDto": {
          "type": "object",
          "properties": {
            "extraPtLoopingApy": {
              "type": "number",
              "description": "Extra fixed APY the latest live campaign promises on this market (0..1), UNLEVERED. Composes as `apy.avgFixedApy + extraPtLoopingApy`; at the held leverage it is worth `extraPtLoopingApy × leverage.currentLeverage`."
            },
            "incentivizedPtRaw": {
              "type": "string",
              "description": "MM PT collateral earning the boost (raw units) — what this box has added since the window opened, i.e. `chainState.collateralRaw − nonIncentivizedPtRaw`."
            },
            "nonIncentivizedPtRaw": {
              "type": "string",
              "description": "MM PT collateral NOT earning the boost (raw units) — the balance this box already held when the window opened, which the campaign did not attract. Add to the position to grow the incentivized side."
            },
            "capReachedTimestamp": {
              "format": "date-time",
              "type": "string",
              "nullable": true,
              "description": "When the campaign filled its `capPT`, or null while it still has room. Past this instant no further PT is admitted however much the market unwinds, so a deposit made after it earns nothing — the reason a fresh top-up can land entirely in `nonIncentivizedPtRaw`."
            }
          },
          "required": [
            "extraPtLoopingApy",
            "incentivizedPtRaw",
            "nonIncentivizedPtRaw",
            "capReachedTimestamp"
          ]
        },
        "PositionBorrowHeadroomDto": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "Box debt token address."
            },
            "amount": {
              "type": "string",
              "description": "Raw debt-token amount still borrowable (bigint string)."
            },
            "valueUsd": {
              "type": "number",
              "description": "USD value at live oracle price."
            }
          },
          "required": [
            "token",
            "amount",
            "valueUsd"
          ]
        },
        "BoxResidualDto": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "Stranded token address — pass as withdraw-sc `outputToken` to recover."
            },
            "amount": {
              "type": "string",
              "description": "Raw token amount held in the box wallet (bigint string)."
            },
            "valueUsd": {
              "type": "number",
              "description": "USD value at live oracle price."
            }
          },
          "required": [
            "token",
            "amount",
            "valueUsd"
          ]
        },
        "PositionDto": {
          "type": "object",
          "properties": {
            "estReturnToMaturityUsd": {
              "type": "number",
              "description": "Estimated total USD PnL at maturity at current rates, excluding incentives. PT only."
            },
            "estReturnUsd": {
              "type": "number",
              "deprecated": true,
              "description": "Same as `estReturnToMaturityUsd`; read that instead."
            },
            "estDailyReturnUsd": {
              "type": "number",
              "description": "Estimated USD earnings over the next day at current rates. Vanilla only."
            },
            "chainId": {
              "type": "number"
            },
            "owner": {
              "type": "string"
            },
            "boxId": {
              "type": "string"
            },
            "boxAddress": {
              "type": "string",
              "description": "CREATE2-derived box contract address — still the DB unique key."
            },
            "moneyMarket": {
              "type": "string",
              "enum": [
                "Aave",
                "Morpho",
                "Euler",
                "Silo",
                "Contango",
                "Lista"
              ]
            },
            "moneyMarketAddress": {
              "type": "string"
            },
            "ptAddress": {
              "type": "string"
            },
            "debtAsset": {
              "type": "string"
            },
            "healthFactor": {
              "type": "number",
              "description": "Position health: 1.0 (100%) healthy down to 0 at liquidation. max(0, 1 - LTV/LLTV). Uses the MM oracle PT/debt rate."
            },
            "activeIntent": {
              "nullable": true,
              "description": "Most-recent non-terminal intent on this box.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/ActiveIntentDto"
                }
              ]
            },
            "chainState": {
              "$ref": "#/components/schemas/PositionChainStateDto"
            },
            "pricing": {
              "$ref": "#/components/schemas/PositionPricingDto"
            },
            "valuation": {
              "$ref": "#/components/schemas/PositionValuationDto"
            },
            "leverage": {
              "$ref": "#/components/schemas/PositionLeverageDto"
            },
            "apy": {
              "$ref": "#/components/schemas/PositionApyDto"
            },
            "liquidationThreshold": {
              "$ref": "#/components/schemas/PositionLiquidationThresholdDto"
            },
            "equity": {
              "$ref": "#/components/schemas/PositionEquityDto"
            },
            "epoch": {
              "$ref": "#/components/schemas/PositionEpochDto"
            },
            "risks": {
              "description": "Operator-curated risk + oracle metadata for this box. Same shape as LoopingOptionDto.risks (same source).",
              "allOf": [
                {
                  "$ref": "#/components/schemas/BoxRisksDto"
                }
              ]
            },
            "ptIncentive": {
              "nullable": true,
              "description": "PT fixed-APY incentive as it applies to this position — the rate, and how much of the collateral is actually in the base. Null when no campaign is live on this position's market.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PositionPtIncentiveDto"
                }
              ]
            },
            "borrowHeadroom": {
              "description": "Additional debt this position can still draw — the borrow-out preview's `maxBorrowable`, same formula. Zero at or above the cap, when the pool has no free liquidity, or while the box market is off peg.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PositionBorrowHeadroomDto"
                }
              ]
            },
            "boxResiduals": {
              "description": "Raw tokens stranded in the box wallet, each recoverable via a withdraw-sc sweep (over dust, no active intent). Includes the debt token plus any arbitrary input token a failed/partial open left behind. Absent when the box holds nothing recoverable.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/BoxResidualDto"
              }
            },
            "isDust": {
              "type": "boolean",
              "description": "True when this position's live net equity is below the $1 dust floor; the dashboard hides these by default via the excludeDust toggle."
            }
          },
          "required": [
            "chainId",
            "owner",
            "boxId",
            "boxAddress",
            "moneyMarket",
            "moneyMarketAddress",
            "ptAddress",
            "debtAsset",
            "healthFactor",
            "chainState",
            "pricing",
            "valuation",
            "leverage",
            "apy",
            "liquidationThreshold",
            "equity",
            "epoch",
            "risks",
            "ptIncentive",
            "borrowHeadroom",
            "isDust"
          ]
        },
        "IntentSummaryDto": {
          "type": "object",
