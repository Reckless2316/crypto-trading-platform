  "layout": "modern",
  "showSidebar": true,
  "isEditable": false,
  "withDefaultFonts": true,
  "searchHotKey": "k",
  "baseServerURL": "https://api-v2.pendle.finance/core",
  "persistAuthentication": false,
  "path": "/docs",
  "showComputingUnits": true,
  "tagOrder": [
    "SDK",
    "Assets",
    "Markets",
    "Ve Pendle",
    "Pendle",
    "Limit Orders",
    "Market Categories",
    "Metadata",
    "Transactions",
    "Statistics",
    "Merkle",
    "Transfer Liquidity",
    "Querier",
    "Chains",
    "Dashboard",
    "Cross PT",
    "PnL",
    "sPENDLE",
    "Integrations",
    "Incentive Rewards",
    "Pendle Emission",
    "Cross Chain Swap",
    "Portal Campaigns",
    "PT Looping",
    "Assets (Legacy)",
    "Markets (Legacy)",
    "Ve Pendle (Legacy)",
    "Pendle (Legacy)",
    "Metadata (Legacy)",
    "Transactions (Legacy)",
    "Statistics (Legacy)",
    "Merkle (Legacy)",
    "Transfer Liquidity (Legacy)",
    "Querier (Legacy)"
  ]
};

          const tagOrder = ["SDK","Assets","Markets","Ve Pendle","Pendle","Limit Orders","Market Categories","Metadata","Transactions","Statistics","Merkle","Transfer Liquidity","Querier","Chains","Dashboard","Cross PT","PnL","sPENDLE","Integrations","Incentive Rewards","Pendle Emission","Cross Chain Swap","Portal Campaigns","PT Looping","Assets (Legacy)","Markets (Legacy)","Ve Pendle (Legacy)","Pendle (Legacy)","Metadata (Legacy)","Transactions (Legacy)","Statistics (Legacy)","Merkle (Legacy)","Transfer Liquidity (Legacy)","Querier (Legacy)"];

          // Initialize Scalar with the configuration
          if (typeof window.Scalar !== 'undefined') {
            window.Scalar.createApiReference(
              document.getElementById('scalar-api-reference'),
              {
                ...config,
                tagsSorter: (a, b) => {
                  // if a and b in tagOrder, sort by tagOrder, otherwise sort by tag name
                  const aIndex = tagOrder.indexOf(a.name);
                  const bIndex = tagOrder.indexOf(b.name);
                  if (aIndex !== -1 && bIndex !== -1) {
                    return aIndex - bIndex;
                  }
                  return a.name.localeCompare(b.name);
                },
                operationsSorter: (a, b) => {
                  const retailRank = config.content.paths[a.path][a.method]['x-retail-api-rank'] ?? 0;
                  const bRetailRank = config.content.paths[b.path][b.method]['x-retail-api-rank'] ?? 0;
                  return retailRank - bRetailRank;
                },
              }
            );
          } else {
            console.error('Scalar API Reference library not loaded');
          }
        } catch (error) {
          console.error('Error initializing Scalar API Reference:', error);
        }
      });
    </script>
  </body>
</html>