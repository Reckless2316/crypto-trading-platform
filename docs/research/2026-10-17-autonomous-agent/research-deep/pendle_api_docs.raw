        "LimitOrderIncentiveSideEntity": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "RELATIVE",
                "ABSOLUTE"
              ],
              "description": "`RELATIVE`: band drifts with market APY. `ABSOLUTE`: band is fixed regardless of market APY."
            },
            "amountPerSec": {
              "type": "number",
              "description": "PENDLE emitted per second to this side. 0 = side disabled."
            },
            "minApy": {
              "type": "number",
              "description": "Effective minimum APY (fraction; 0.05 = 5%). Undefined when side is disabled."
            },
            "maxApy": {
              "type": "number",
              "description": "Effective maximum APY (fraction; 0.05 = 5%). Undefined when side is disabled."
            }
          },
          "required": [
            "mode",
            "amountPerSec"
          ]
        },
        "LimitOrderIncentiveEntity": {
          "type": "object",
          "properties": {
            "amountPerSec": {
              "type": "number",
              "description": "Total PENDLE emitted per second across LONG and SHORT."
            },
            "impliedApy": {
              "type": "number",
              "description": "Current market implied APY (fraction; 0.05 = 5%)."
            },
            "buyYtApr": {
              "type": "number",
              "description": "APR a maker earns buying YT on the long side."
            },
            "sellPtApr": {
              "type": "number",
              "description": "APR a maker earns selling PT on the long side."
            },
            "sellYtApr": {
              "type": "number",
              "description": "APR a maker earns selling YT on the short side."
            },
            "buyPtApr": {
              "type": "number",
              "description": "APR a maker earns buying PT on the short side."
            },
            "long": {
              "description": "LONG side (buying YT / selling PT) config.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LimitOrderIncentiveSideEntity"
                }
              ]
            },
            "short": {
              "description": "SHORT side (selling YT / buying PT) config.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LimitOrderIncentiveSideEntity"
                }
              ]
            }
          },
          "required": [
            "amountPerSec",
            "impliedApy",
            "long",
            "short"
          ]
        },
        "PendleEmissionEntity": {
