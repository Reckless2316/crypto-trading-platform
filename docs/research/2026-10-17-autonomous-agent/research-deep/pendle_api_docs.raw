            },
            "totalSupply": {
              "type": "number",
              "description": "Total supply of the LP token"
            },
            "ptPrice": {
              "type": "number",
              "description": "PT price in USD"
            },
            "ytPrice": {
              "type": "number",
              "description": "YT price in USD"
            },
            "syPrice": {
              "type": "number",
              "description": "SY price in USD"
            },
            "lpPrice": {
              "type": "number",
