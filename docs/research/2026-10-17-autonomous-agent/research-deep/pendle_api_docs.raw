      "/v1/statistics/pt-looping-volume": {
        "get": {
          "description": "USD volume routed through each PT-looping box (PT x money market x debt token) over a trailing `period` (`7d`, `30d` default, or `all`) ending now, split into buy (increase) and sell (decrease) iterations and sorted by total descending. 7d / 30d windows start at UTC midnight of the first day. Boxes with no volume in the period are omitted. `positionCount` is the number of distinct positions that routed volume; no owner data is returned. Computed once per 5 minutes and shared across periods and chains.",
          "operationId": "StatisticsController_getPtLoopingVolume",
          "parameters": [
            {
              "name": "period",
              "required": false,
              "in": "query",
              "description": "Trailing window ending now; 7d / 30d start at UTC midnight of that day, `all` from the first iteration.",
              "schema": {
                "default": "30d",
                "enum": [
                  "7d",
                  "30d",
                  "all"
                ],
                "type": "string"
              }
            },
            {
              "name": "chainId",
              "required": false,
              "in": "query",
              "description": "Chain id to filter by; omit for every chain.",
              "schema": {
                "example": 42161,
                "type": "number"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/PtLoopingVolumeResponse"
