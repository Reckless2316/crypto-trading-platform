        "MerkleUserCampaignResponse": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string",
              "description": "User wallet address"
            },
            "token": {
              "type": "string",
              "description": "Reward token address"
            },
            "merkleRoot": {
              "type": "string",
              "description": "Merkle root hash of the distribution tree"
            },
            "chainId": {
              "type": "number",
              "description": "Chain ID where the reward is distributed"
            },
            "assetId": {
              "type": "string",
              "description": "Asset ID (chainId-address) of the Pendle asset associated with this reward. Absent when the reward names a campaign instead — see `title`. Exactly one of the two is always present."
            },
            "title": {
              "type": "string",
              "description": "Human-readable campaign name, for rewards that are not tied to a Pendle market (for example a one-off airdrop). Absent when `assetId` is set."
            },
            "amount": {
              "type": "string",
              "description": "Reward amount in the reward token decimals, as a string"
            },
            "toTimestamp": {
              "format": "date-time",
              "type": "string",
              "description": "End timestamp of the reward period"
            },
            "fromTimestamp": {
              "format": "date-time",
              "type": "string",
              "description": "Start timestamp of the reward period"
            }
          },
          "required": [
            "user",
            "token",
            "merkleRoot",
            "chainId",
            "amount"
          ]
        },
        "MerkleRewardTotalResponse": {
          "type": "object",
          "properties": {
