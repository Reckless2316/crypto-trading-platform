      "/v1/pt-looping/loop/positions": {
        "get": {
          "description": "Returns one row per `(PT, money market, debt token)` box the owner holds, with live valuation, leverage, looping APY, health factor and any in-flight intent. Omit `chainId` to fetch every chain in one call, or pass it (optionally with `ptAddress`/`mmAddress`) to scope to one chain.",
          "operationId": "PtLoopingController_listPositions",
          "parameters": [
            {
              "name": "chainId",
              "required": false,
              "in": "query",
              "description": "Optional — omit to return the owner’s positions across every chain in one call. Required to narrow to a single box (with ptAddress+mmAddress+debtToken).",
              "schema": {
                "example": 42161,
                "type": "number"
              }
            },
            {
              "name": "owner",
              "required": true,
              "in": "query",
              "schema": {
                "example": "0x1111111111111111111111111111111111111111",
                "type": "string"
              }
            },
            {
              "name": "ptAddress",
              "required": false,
              "in": "query",
              "description": "Optional — filter to a specific PT address",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "mmAddress",
              "required": false,
              "in": "query",
              "description": "Optional — only narrows to a single box together with `ptAddress` AND `debtToken` (the box identity on shared-pool MMs). On its own it does not filter the fan-out.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "debtToken",
              "required": false,
              "in": "query",
              "description": "Optional — box debt token. Required alongside ptAddress+mmAddress to resolve a single box on shared-pool MMs (Aave); otherwise the list fans out across debt variants.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "boxId",
              "required": false,
              "in": "query",
              "description": "Box id (bytes32). Picks the box when two boxes share (chainId, ptAddress, mmAddress, debtToken); must match that tuple.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "excludeDust",
              "required": false,
              "in": "query",
              "description": "Default true — hides positions where both collateral and debt USD value are < $1 (the contract-mandated dust anchor that's left after a 100% close). Pass `false` to include them (ops/forensics, or a 'show closed positions' UI toggle).",
              "schema": {
                "default": true,
                "type": "boolean"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PositionDto"
                    }
                  }
                }
              }
            }
          },
          "summary": "Get PT-looping positions for an owner",
          "tags": [
            "PT Looping"
          ],
          "x-computing-unit": "5+",
          "x-retail-api-rank": 1
        }
      },
