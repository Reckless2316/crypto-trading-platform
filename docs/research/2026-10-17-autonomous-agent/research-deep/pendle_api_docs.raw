        "ReadyPortalCampaignResponse": {
          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "example": 42161
            },
            "marketAddress": {
              "type": "string",
              "example": "0x6b92feb89ed16aa971b096e247fe234db4aaa262"
            },
