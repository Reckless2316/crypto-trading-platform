        "SimulateBreakevenBorrowDto": {
          "type": "object",
          "properties": {
            "rate": {
              "type": "number",
              "description": "Borrow APY at which leveraged returns equal unleveraged."
            },
            "current": {
              "type": "number",
              "nullable": true,
              "description": "Observed borrow APY at quote time."
            }
          },
          "required": [
            "rate"
          ]
        },
        "SimulateFeeBreakdownDto": {
          "type": "object",
          "properties": {
            "serviceUsd": {
              "type": "number",
              "description": "Looper service fee (USD)."
            },
            "tradingUsd": {
              "type": "number",
              "description": "PT trade fee (USD) on the swap legs. Zero for ZPI."
            },
            "priceImpactUsd": {
              "type": "number",
              "description": "Value lost to aggregator swap price impact (USD)."
            },
            "gasUsd": {
              "type": "number",
              "description": "Network gas cost (USD) across executor iterations."
            }
          },
          "required": [
            "serviceUsd",
            "tradingUsd",
            "gasUsd"
          ]
        },
        "SimulateMetricsDto": {
          "type": "object",
          "properties": {
            "additionalEstReturnUsd": {
              "type": "number",
              "description": "Additional USD earnings versus keeping the existing position."
            },
            "avgFixedApy": {
              "type": "number",
              "nullable": true,
              "description": "Post-action weighted-avg fixed APY of held PT."
            },
            "borrowApy": {
              "type": "number",
              "nullable": true,
              "description": "Post-action 6-hour-average MM borrow APY (0..1) at quote time."
            },
            "borrowApy7dAvg": {
              "type": "number",
              "nullable": true,
              "description": "Trailing 7-day-average MM borrow APY (0..1)."
            },
            "estReturnToMaturityUsd": {
              "type": "number",
              "nullable": true,
              "description": "USD return compounded to maturity on the deposit, less gas. PT only."
            },
            "estReturnUsd": {
              "type": "number",
              "nullable": true,
              "deprecated": true,
              "description": "Same as `estReturnToMaturityUsd`; read that instead."
            },
            "estDailyReturnUsd": {
              "type": "number",
              "nullable": true,
              "description": "USD earned per day at the post-action looping APY, excluding one-time costs. Vanilla only."
            },
            "openingCostUsd": {
              "type": "number",
              "nullable": true,
              "description": "One-time USD cost of the action; null on PT and on actions that reduce exposure."
            },
            "breakevenDays": {
              "type": "number",
              "nullable": true,
              "description": "Days until the added daily return repays openingCostUsd; null when the action adds none."
            },
            "estExtraReturnUsd": {
              "type": "number",
              "description": "Campaign rewards over the remaining window (USD). Priced SDK-side, not served by the backend."
            },
            "serviceFeeRate": {
              "type": "number",
              "description": "Looping fee as a fraction of routed volume."
            },
            "priceImpact": {
              "type": "number",
              "description": "Swap price impact as a fraction of routed volume."
            },
            "feeRateApy": {
              "type": "number",
              "description": "Entry cost annualised."
            },
            "baseLoopingApy": {
              "type": "number",
              "description": "Looping APY before the entry cost."
            },
            "loopingApy": {
              "type": "number",
              "description": "Fee-inclusive looping APY the return compounds at."
            },
            "daysToMaturity": {
              "type": "number",
              "description": "Fractional days from quote time to maturity."
            },
            "breakevenBorrow": {
              "nullable": true,
              "description": "Borrow APY at which leveraged returns equal unleveraged.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/SimulateBreakevenBorrowDto"
                }
              ]
            },
            "liquidationPtPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "PT USD price that trips liquidation."
            },
            "liquidationUnderlyingPriceUsd": {
              "type": "number",
              "nullable": true,
              "description": "Underlying USD price that trips liquidation."
            },
            "fee": {
              "nullable": true,
              "description": "Fee components (USD); total = service + trading + gas.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/SimulateFeeBreakdownDto"
                }
              ]
            }
          }
        },
        "LoopIterationInputKind": {
          "type": "string",
          "enum": [
            "INPUT_TOKEN",
            "DEBT",
            "PT"
