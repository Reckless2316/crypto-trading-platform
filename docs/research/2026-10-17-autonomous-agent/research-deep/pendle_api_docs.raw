              "description": "Paragraph describing this box and its liquidation triggers."
            },
            "items": {
              "description": "The liquidation-risk rows.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RiskItemDto"
              }
            },
            "ptOracleType": {
              "type": "string",
              "enum": [
                "linear",
                "marketPrice",
                "hardcoded"
              ],
              "description": "Oracle strategy the MM uses to price PT collateral."
            },
            "debtOracleType": {
              "type": "string",
              "enum": [
                "linear",
                "marketPrice",
                "hardcoded"
              ],
              "description": "Oracle strategy the MM uses to price the debt / underlying."
            }
          },
          "required": [
            "overall",
