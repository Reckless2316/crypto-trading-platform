          "type": "object",
          "properties": {
            "chainId": {
              "type": "number",
              "example": 42161
            },
            "ptAddress": {
              "type": "string",
              "example": "0x1cdde40e29da213f42a7fa109ccadca372d9ee1b"
            },
            "info": {
              "$ref": "#/components/schemas/LoopingInfoDto"
            }
          },
          "required": [
            "chainId",
            "ptAddress",
            "info"
          ]
        },
        "ListLoopingPtsResponse": {
          "type": "object",
          "properties": {
            "results": {
              "description": "Every loopable PT, ordered by chain then PT address.",
              "type": "array",
              "items": {
