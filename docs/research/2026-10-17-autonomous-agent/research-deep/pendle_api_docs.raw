              "type": "string",
              "description": "Opaque campaign handle — the id every other campaign route takes."
            },
            "receiverType": {
              "type": "string",
              "enum": [
                "YT_HOLDERS",
                "LP_HOLDERS",
                "LP_YT_HOLDERS",
                "PT_LOOPING_HOLDERS",
                "YT_TRADERS"
              ],
              "description": "Which holders of the market the campaign pays."
            },
            "tokens": {
              "description": "Reward tokens and their budgets, with how much is funded on-chain and already distributed.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PortalExternalMerkleTokenResponse"
              }
