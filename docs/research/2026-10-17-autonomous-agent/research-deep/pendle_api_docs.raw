              }
            }
          },
          "required": [
            "results"
          ]
        },
        "LoopingChartPointDto": {
          "type": "object",
          "properties": {
            "timestamp": {
              "type": "number",
              "description": "Bucket start, unix seconds."
            },
            "borrowApy": {
              "type": "number",
              "description": "Trailing 6-hour average pool borrow APY (0..1)."
            },
            "borrowApySpot": {
              "type": "number",
              "nullable": true,
              "description": "Pool borrow APY (0..1) at the bucket close."
            },
            "borrowApy7dAvg": {
              "type": "number",
              "description": "Trailing 7-day average pool borrow APY (0..1)."
            },
            "liquidityUsd": {
              "type": "number",
              "nullable": true,
              "description": "Available borrowing liquidity in USD."
            },
            "ptOraclePriceInDebt": {
              "type": "number",
              "nullable": true,
              "description": "Money-market oracle PT price, in debt-token units."
            },
            "ptMarketPriceInDebt": {
              "type": "number",
              "nullable": true,
              "description": "PT market price, in debt-token units."
            },
            "fixedApy": {
              "type": "number",
              "nullable": true,
              "description": "The PT's own fixed APY (market impliedApy, 0..1) in this bucket."
            },
            "maxApy": {
              "type": "number",
              "nullable": true,
              "description": "Max looping APY at max safe leverage (0..1) in this bucket. Excludes the PT fixed-APY extra incentive — read that from the market history endpoint as `extraPtLoopingApy`."
            },
            "collateralApy": {
              "type": "number",
              "nullable": true,
              "description": "Collateral APY (0..1) in this bucket, asset yield compounded with lender supply APY; null on PT."
            }
          },
          "required": [
            "timestamp",
            "borrowApy",
            "borrowApySpot",
            "borrowApy7dAvg",
            "liquidityUsd",
            "ptOraclePriceInDebt",
            "ptMarketPriceInDebt",
            "fixedApy",
            "maxApy",
            "collateralApy"
          ]
        },
        "LoopingChartSeriesDto": {
          "type": "object",
          "properties": {
            "boxId": {
              "type": "string",
              "description": "Box id (bytes32); one series per box."
            },
            "moneyMarketAddress": {
              "type": "string",
              "example": "0x72ff0566d069d03b3b7b724cdb17c3bfc5926086"
            },
            "debtAsset": {
              "type": "string",
              "example": "0xaf88d065e77c8cc2239327c5edb3a432268e5831",
              "description": "Box debt token; distinguishes series that share an mmAddress on shared-pool MMs (Aave)."
            },
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LoopingChartPointDto"
              }
            }
          },
          "required": [
            "boxId",
            "moneyMarketAddress",
            "debtAsset",
            "points"
          ]
        },
        "LoopingChartsResponseDto": {
          "type": "object",
          "properties": {
            "timeFrame": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week"
              ]
            },
            "timestampStart": {
              "type": "number",
              "description": "Unix seconds, inclusive."
            },
            "timestampEnd": {
              "type": "number",
              "description": "Unix seconds, inclusive."
            },
            "series": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LoopingChartSeriesDto"
              }
            }
          },
          "required": [
            "timeFrame",
            "timestampStart",
            "timestampEnd",
            "series"
          ]
        },
        "TransactionHistoryRowDto": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "`${chainId}-${txHash}-${logIndex}` — stable React key."
            },
            "chainId": {
              "type": "number"
            },
            "txHash": {
              "type": "string"
            },
            "blockNumber": {
              "type": "number"
            },
            "blockTimestamp": {
              "type": "number",
              "description": "Unix seconds."
            },
            "direction": {
              "type": "string",
              "enum": [
                "buy",
                "sell"
              ],
              "description": "`buy` = bought PT this iter; `sell` = sold PT this iter. Omitted on liquidation rows."
            },
            "requestKind": {
              "type": "string",
              "enum": [
                "open",
                "levUp",
                "addPosition",
                "addCollateral",
                "repay",
                "borrowOut",
                "levDown",
                "withdraw"
              ],
              "description": "Parent action kind — drives `(Open) / (Lev Up) / (Add Position) / (Add Collateral) / (Repay) / (Borrow Out) / (Lev Down) / (Withdraw)` parenthetical. Omitted on liquidation rows."
            },
            "liquidation": {
              "type": "string",
              "enum": [
                "full",
                "partial"
              ],
              "description": "Set when this row is an MM liquidation."
            },
            "iterIndex": {
              "type": "number",
              "description": "1-based iter ordinal within the parent Request. Omitted on liquidation rows."
            },
            "iterCount": {
              "type": "number",
              "nullable": true,
              "description": "Total iters in the parent Request. `null` while still mid-execution."
            },
            "mmPtBalance": {
              "type": "string",
              "description": "Box PT balance in MM after this iter (raw bigint string)."
            },
            "mmDebtBalance": {
              "type": "string",
              "description": "Box debt owed to MM after this iter (raw bigint string)."
            },
            "mmPtBalanceUsd": {
              "type": "number",
              "description": "USD value of `mmPtBalance`."
            },
            "mmDebtBalanceUsd": {
              "type": "number",
              "description": "USD value of `mmDebtBalance`."
            },
            "preMmPtBalance": {
              "type": "string",
              "description": "Pre-event MM PT balance (raw). Set only when `liquidation` is set."
            },
            "preMmDebtBalance": {
              "type": "string",
              "description": "Pre-event MM debt balance (raw). Set only when `liquidation` is set."
            },
            "preMmPtBalanceUsd": {
              "type": "number",
              "description": "Pre-event MM PT USD value. Set only when `liquidation` is set."
            },
            "preMmDebtBalanceUsd": {
              "type": "number",
              "description": "Pre-event MM debt USD value. Set only when `liquidation` is set."
            },
            "leverage": {
              "type": "number",
              "nullable": true,
              "description": "Position leverage at this iter. Null when equity ≤ 0."
            },
            "borrowApy": {
              "type": "number",
              "description": "Annualized MM borrow rate at this iter (decimal)."
            },
            "fixedApy": {
              "type": "number",
              "nullable": true,
              "description": "Average fixed APY of the PT held at this iter. Null on vanilla."
            },
            "loopingApy": {
              "type": "number",
              "nullable": true,
              "description": "`collateral APY × leverage − borrowApy × (leverage − 1)`; the collateral APY is `fixedApy` on PT."
            },
            "healthFactor": {
              "type": "number",
              "description": "Position health: 1.0 (100%) healthy down to 0 at liquidation. max(0, 1 - LTV/LLTV)."
            },
            "netYtRedeemed": {
              "type": "string",
              "description": "YT redeemed in this iteration, in raw units."
            }
          },
          "required": [
            "id",
            "chainId",
            "txHash",
            "blockNumber",
            "blockTimestamp",
            "iterCount",
            "mmPtBalance",
            "mmDebtBalance",
            "mmPtBalanceUsd",
            "mmDebtBalanceUsd",
            "leverage",
            "borrowApy",
            "fixedApy",
            "loopingApy",
            "healthFactor"
          ]
        },
        "IntentTypeIncreaseSc": {
          "type": "string",
          "enum": [
            "INCREASE_SC"
          ]
        },
        "LoopingActionType": {
          "type": "string",
          "enum": [
            "deposit",
            "increase_lev",
            "add_position",
            "add",
            "repay",
            "borrow_out",
            "decrease_leverage",
            "partial_withdraw",
            "close",
            "rescue"
          ]
        },
        "IntentStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "AWAITING_DEPOSIT",
            "EXECUTING",
            "COMPLETED",
            "COMPLETED_WITH_RESIDUAL",
            "FAILED",
            "CANCELLED",
            "EXPIRED"
          ]
        },
        "IntentIterationDto": {
          "type": "object",
          "properties": {
            "index": {
              "type": "number"
            },
            "txHash": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "revert"
              ]
            },
            "amountIn": {
              "type": "string"
            },
            "amountOut": {
              "type": "string"
            },
            "borrowedAmount": {
              "type": "string",
              "description": "BUY iters: debt borrowed."
            },
            "repaidAmount": {
              "type": "string",
              "description": "SELL iters: debt repaid."
            },
            "executedRate": {
              "type": "string",
              "description": "Actual executed swap rate for this iter (FixedX18 WAD)."
            }
          },
          "required": [
            "index"
          ]
        },
        "IntentErrorCode": {
          "type": "string",
          "enum": [
            "LIMIT_PRICE_VIOLATED",
            "LIMITS_UNSATISFIABLE",
            "CHAIN_STALL",
            "INTERNAL_STUCK",
            "FINALIZE_STUCK",
            "SUSPICIOUS_ACTION",
            "REQUEST_EXPIRED",
            "GAS_PRICE_TOO_HIGH",
            "PERMIT_EXPIRED",
            "FEES_TOO_HIGH",
            "AT_LIQUIDATION",
            "AT_CAP_NEEDS_SEED",
            "SWAP_RATE_UNREACHABLE",
            "STALE_SESSION_NONCE",
            "PERMIT_BUDGET_EXHAUSTED",
            "FINALIZE_STUCK_WITH_RESIDUAL",
            "WITHDRAW_PARTIAL_RESUMABLE",
            "WITHDRAW_FLOOR_LTV_BLOCKED",
            "DELEVERAGE_GATE_BREACHED_RESIDUAL",
            "DELEVERAGE_RESIDUAL_PARKED",
            "SWEEP_NONCE_DRIFTED",
            "SWEEP_DEBT_LEFT_IN_BOX",
            "YT_INSUFFICIENT",
            "UNKNOWN"
          ]
        },
        "SimulateTokenAmountDto": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Raw token amount (bigint string, token-decimal-scaled)."
            },
            "valueUsd": {
              "type": "number",
              "description": "USD value at quote time."
            }
          },
          "required": [
