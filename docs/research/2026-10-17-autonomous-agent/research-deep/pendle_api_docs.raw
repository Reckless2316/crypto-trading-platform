              "type": "string",
              "description": "Method name"
            },
            "contractCallParamsName": {
              "description": "Contract call parameters name",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contractCallParams": {
              "description": "Contract call parameters",
              "type": "array",
              "items": {
                "type": "array"
              }
            },
            "tx": {
              "description": "Transaction data",
              "allOf": [
                {
                  "$ref": "#/components/schemas/TransactionDto"
                }
              ]
            },
            "tokenApprovals": {
              "description": "ERC-20 token approvals required before submitting tx. Approve at least the given amount to the router contract for each entry",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TokenAmountResponse"
              }
            },
            "data": {
