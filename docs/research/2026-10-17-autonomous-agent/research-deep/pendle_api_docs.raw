            "markets": {
              "description": "Sorted by poolFeeUsd desc",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MarketFeesMarketResponse"
              }
            }
          },
          "required": [
            "epochStart",
            "epochEnd",
            "isOngoing",
            "totals",
            "markets"
          ]
