        "RewardApyBreakdownEntity": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "description": "Reward token asset ID in format \"chainId-address\" (e.g., \"1-0x...\")"
            },
            "absoluteApy": {
              "type": "number",
              "description": "Absolute APY contribution from this reward token in decimal format (e.g., 0.05 = 5%)"
            },
            "relativeApy": {
              "type": "number",
              "description": "Relative APY contribution as a percentage of total APY in decimal format"
            },
            "source": {
              "type": "string",
              "enum": [
                "CONTRACT",
                "EXTERNAL_REWARD",
                "PORTAL_INCENTIVE",
                "PENDLE_CO_BRIBE",
                "DYNAMIC_INCENTIVE",
                "CONTRACT_DISCRETE"
              ],
              "description": "Source of the reward: CONTRACT (on-chain) or EXTERNAL_REWARD/PORTAL_INCENTIVE (off-chain)"
            },
            "ytExclusive": {
              "type": "boolean",
              "description": "If true, this reward is only claimable by YT (Yield Token) holders, not LPs"
            },
            "lpExclusive": {
              "type": "boolean",
              "description": "If true, this reward is only claimable by LP (Liquidity Provider) holders, not YTs"
            },
            "portalExtData": {
              "description": "Extended data for Portal incentive campaigns (amount, start/end timestamps)",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PortalExtDataEntity"
                }
              ]
            }
          },
          "required": [
            "asset",
            "absoluteApy",
            "relativeApy"
          ]
        },
