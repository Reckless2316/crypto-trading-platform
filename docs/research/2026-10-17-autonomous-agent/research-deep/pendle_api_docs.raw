        "MarketFeesEpochResponse": {
          "type": "object",
          "properties": {
            "epochStart": {
              "type": "string",
              "description": "ISO, Tuesday 00:00 UTC"
            },
            "epochEnd": {
              "type": "string",
              "description": "ISO, epochStart + 14 days"
            },
            "isOngoing": {
              "type": "boolean",
              "description": "True when the epoch has not closed yet; its figures are partial"
            },
            "totals": {
              "description": "Sum over the markets listed",
              "allOf": [
                {
                  "$ref": "#/components/schemas/MarketFeeRowResponse"
