          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "description": "The generator mode that paid this reward",
              "example": "LP_YT"
            },
            "campaignId": {
              "type": "string",
              "description": "The funding campaign behind this reward, when there is one (the portal campaign id)"
            },
            "position": {
              "type": "string",
              "description": "The position that earned this reward: LP, YT, PT, SY or LO (limit-order maker). Absent for rewards no position earns (vePENDLE, sPENDLE).",
              "example": "YT"
            }
          }
        },
        "MerkleRewardWindowResponse": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Amount in the reward token decimals, as a string"
            },
            "merkleRoot": {
              "type": "string",
              "description": "The root this window was distributed in. Absent on unrealized rows"
            },
            "fromTimestamp": {
              "format": "date-time",
              "type": "string",
              "description": "Start of the distribution window"
            },
            "toTimestamp": {
              "format": "date-time",
              "type": "string",
              "description": "End of the distribution window"
            },
            "source": {
              "description": "Where this reward came from: the paying mode, the funding campaign and the position that earned it. Absent for rewards distributed before it was tracked.",
              "allOf": [
                {
                  "$ref": "#/components/schemas/MerkleRewardSourceResponse"
                }
              ]
            },
            "displayTitle": {
              "type": "string",
              "description": "The title to show for this reward: `title`, falling back to the label of the generator mode that paid it. Never contains a date — show `fromTimestamp`/`toTimestamp` for the period.",
              "example": "Discrete Yield"
            }
          },
          "required": [
            "amount",
            "fromTimestamp",
            "toTimestamp",
            "displayTitle"
          ]
        },
        "MerkleRewardEntryResponse": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "Reward token: an id (`chainId-address`) in bff, an address in core"
            },
            "cadence": {
              "type": "string",
              "description": "How often this token is distributed, where a schedule is configured",
              "example": "monthly"
            },
            "nextDistributionAt": {
              "format": "date-time",
              "type": "string",
              "description": "When the next distribution is expected, where a schedule is configured"
            },
            "total": {
              "$ref": "#/components/schemas/MerkleRewardTotalResponse"
            },
            "claimable": {
              "description": "One row per distribution window not yet claimed, oldest first",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MerkleRewardWindowResponse"
              }
            },
            "unrealized": {
              "description": "The open window, accrued so far. An estimate",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MerkleRewardWindowResponse"
              }
            },
            "chainId": {
              "type": "number"
            },
            "assetId": {
              "type": "string",
              "description": "The market this reward is for. Absent when it names a campaign — see `title`"
            },
            "title": {
              "type": "string",
              "description": "Campaign name, for rewards with no market. Absent when `assetId` is set"
            }
          },
          "required": [
            "token",
            "total",
            "claimable",
