        "TransactionType": {
          "type": "string",
          "enum": [
            "TRADES",
            "LIQUIDITY"
          ]
        },
        "TransactionAction": {
          "type": "string",
          "enum": [
            "BUY_PT",
            "SELL_PT",
            "BUY_YT",
            "SELL_YT",
            "LONG_YIELD",
            "SHORT_YIELD",
            "ADD_LIQUIDITY",
