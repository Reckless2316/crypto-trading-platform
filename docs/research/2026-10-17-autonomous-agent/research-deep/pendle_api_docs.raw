            "initiatedBy": {
              "type": "string",
              "description": "Entity that initiated this market listing (e.g., \"Pendle Team\")"
            },
            "auditedUrl": {
              "type": "string",
              "description": "URL to the audit report"
            },
            "conversionRate": {
              "description": "Unit conversion from underlying to pyUnit",
              "allOf": [
                {
                  "$ref": "#/components/schemas/ConversionRateEntity"
                }
              ]
            },
            "utilizedProtocols": {
              "description": "Protocols utilized by this market",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/UtilizedProtocolResponse"
              }
            },
            "deposit": {
              "description": "Native deposit route info",
              "allOf": [
                {
                  "$ref": "#/components/schemas/DepositWithdrawalInfoEntity"
                }
              ]
            },
            "withdrawal": {
              "description": "Native withdrawal route info",
              "allOf": [
                {
                  "$ref": "#/components/schemas/DepositWithdrawalInfoEntity"
                }
              ]
            }
          },
          "required": [
            "utilizedProtocols"
          ]
        },
        "MarketCrossChainDataV2": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "market name",
              "example": "crvUSD"
            },
            "protocol": {
              "type": "string",
              "description": "Protocol behind the market underlying asset (e.g. Aave, Ethena). Manually curated; may be absent.",
              "nullable": true,
              "example": "Ethena"
            },
            "icon": {
              "type": "string",
              "description": "market icon URL"
            },
            "address": {
              "type": "string",
              "description": "market address",
              "example": "0x386f90eb964a477498b528a39d9405e73ed4032b"
            },
            "expiry": {
              "type": "string",
              "description": "market expiry date",
              "example": "2024-03-28T00:00:00.000Z"
            },
            "pt": {
              "type": "string",
              "description": "market pt id",
              "example": "1-0xb87511364014c088e30f872efc4a00d7efb843ac"
            },
            "yt": {
              "type": "string",
              "description": "market yt id",
              "example": "1-0xed97f94dd94255637a054098604e0201c442a3fd"
            },
            "sy": {
              "type": "string",
              "description": "market sy id",
              "example": "1-0xe05082b184a34668cd8a904d85fa815802bbb04c"
            },
            "underlyingAsset": {
              "type": "string",
              "description": "market underlying asset id",
              "example": "1-0xa663b02cf0a4b149d2ad41910cb81e23e1c41c32"
            },
            "accountingAsset": {
              "type": "string",
              "description": "accounting asset id",
              "example": "1-0xa663b02cf0a4b149d2ad41910cb81e23e1c41c32"
            },
            "rewardTokens": {
              "description": "reward token ids",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inputTokens": {
              "description": "accepted input token ids for minting SY",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputTokens": {
              "description": "output token ids when redeeming SY",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "details": {
              "description": "Market details including liquidity, APY, fee rate, and yield range",
              "allOf": [
                {
                  "$ref": "#/components/schemas/MarketDetailsV2Entity"
                }
              ]
            },
            "isNew": {
              "type": "boolean",
              "description": "Whether the market is new"
            },
            "isPrime": {
              "type": "boolean",
              "description": "Whether the market is prime"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string",
              "description": "Market deployed timestamp"
            },
            "lpWrapper": {
              "type": "string",
              "description": "LP wrapper address"
            },
            "categoryIds": {
              "description": "Market category IDs",
              "example": [
                "btc",
                "stables"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isVolatile": {
              "type": "boolean",
              "description": "Underlying asset is considered volatile, affects risk labelling"
            },
            "marketType": {
              "type": "string",
              "enum": [
                "discrete_yield"
              ],
              "description": "How the underlying yield reaches the holder. Absent means it accrues continuously; `discrete_yield` means it is booked over a window and paid in one lump, so the exchange rate is expected to sit flat in between."
            },
            "underlyingRewardApyBreakdown": {
              "deprecated": true,
              "description": "Breakdown of underlying reward APY by reward token",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RewardApyBreakdownEntity"
              }
            },
            "lpRewardApyBreakdown": {
              "deprecated": true,
              "description": "Breakdown of LP reward APY by reward token",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/RewardApyBreakdownEntity"
              }
            },
            "ytApyBreakdown": {
              "description": "Structured YT APY breakdown (for YT holders)",
              "allOf": [
                {
                  "$ref": "#/components/schemas/YtApyBreakdownEntity"
                }
              ]
            },
            "lpApyBreakdown": {
              "description": "Structured LP APY breakdown (for LP providers)",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LpApyBreakdownEntity"
                }
              ]
            },
            "chainId": {
              "type": "number",
              "description": "chain id",
              "example": 1
            },
            "points": {
              "description": "Points reward configurations for this market, if any",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PointMetadataEntity"
              }
            },
            "externalProtocols": {
              "description": "External protocol integrations (e.g. Aave, Morpho, Euler) available for this market's assets",
              "allOf": [
                {
                  "$ref": "#/components/schemas/MarketExternalProtocolsEntity"
                }
              ]
            },
            "incentiveCampaigns": {
              "description": "Active incentive campaigns for this market",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/IncentiveCampaignEntity"
              }
            },
            "limitOrderIncentive": {
              "description": "Limit order maker incentive config for this market",
              "allOf": [
                {
                  "$ref": "#/components/schemas/LimitOrderIncentiveEntity"
                }
              ]
            },
            "pendleEmission": {
              "description": "Weekly PENDLE emission breakdown for this market",
              "allOf": [
                {
                  "$ref": "#/components/schemas/PendleEmissionEntity"
                }
              ]
            },
            "marketInfo": {
              "description": "Market information including asset description, risks, deposit/withdrawal details, and utilized protocols",
              "allOf": [
                {
                  "$ref": "#/components/schemas/MarketInfoEntity"
                }
              ]
            }
          },
          "required": [
            "name",
            "icon",
            "address",
            "expiry",
            "pt",
            "yt",
            "sy",
            "underlyingAsset",
            "accountingAsset",
            "rewardTokens",
            "inputTokens",
            "outputTokens",
            "details",
            "isNew",
            "isPrime",
            "timestamp",
            "chainId"
          ]
        },
        "GetMarketsCrossChainV2Response": {
