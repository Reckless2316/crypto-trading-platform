`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"output_tokens\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`18`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Each Score answer has five values:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`type`}),`: The type of TypeSafe question.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`probabilities`}),`: The probability of each level, keyed by level number as a string. The sum of all values is 1.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`score`}),`: The position on the level number line, from 0 to the top level number, which is 2 here. It’s each level number multiplied by its probability, added up: 0 x 0.0 + 1 x 0.57 + 2 x 0.43 = 1.43.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`legend`}),`: Each level number mapped back to its description.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`/confidence`,children:_jsx(_components.code,{children:`confidence`})}),`: A number from 0 to 1 computed from how `,_jsx(_components.code,{children:`probabilities`}),` is spread. A single peak on one level means high confidence. Probability spread over several levels means low confidence.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`A score of 1.43 means the model is split between levels 1 and 2, leaning to level 1. That matches the report: the export is broken, and switching to Chrome is a workaround for most customers, but not for the ones who only use Safari. The model puts 0.57 on “workaround exists” and 0.43 on “no workaround”, and confidence is 0.35 because it’s split.`}),`\n`,_jsxs(_components.p,{children:[`Using the Python SDK, `,_jsx(_components.code,{children:`ScoreAnswer`}),` has `,_jsx(_components.code,{children:`score`}),`, `,_jsx(_components.code,{children:`confidence`}),`, `,_jsx(_components.code,{children:`probabilities`}),`, and `,_jsx(_components.code,{children:`legend`}),` as typed fields. The SDK keys `,_jsx(_components.code,{children:`probabilities`}),` and `,_jsx(_components.code,{children:`legend`}),` by integer level rather than by string.`]}),`\n`,_jsx(Heading,{level:`2`,id:`reading-a-score`,children:`Reading a Score`}),`\n`,_jsx(_components.p,{children:`Let’s look at how the score changes with different inputs. For example, using the question and its levels from the request above:`}),`\n`,_jsx(CodeBlock,{numberOfLines:`5`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`\"How severe is the reported issue?\"`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`  → 0: Cosmetic; no impact to functionality`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`  → 1: Broken or degraded feature, but workaround exists`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`  → 2: Blocking issue; no workaround exists`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(_components.p,{children:`We can see how different bug reports change the score:`}),`\n`,_jsxs(`table`,{children:[_jsxs(`thead`,{children:[_jsxs(`tr`,{children:[_jsx(`th`,{colSpan:3}),_jsx(`th`,{colSpan:3,style:{textAlign:`left`},children:_jsx(`code`,{children:`probabilities`})})]}),_jsxs(`tr`,{children:[_jsx(`th`,{style:{width:`44%`},children:`State`}),_jsx(`th`,{style:{width:`12%`,whiteSpace:`nowrap`},children:_jsx(`code`,{children:`score`})}),_jsx(`th`,{style:{width:`16%`,whiteSpace:`nowrap`},children:_jsx(`code`,{children:`confidence`})}),_jsx(`th`,{style:{width:`9%`,whiteSpace:`nowrap`},children:`Level 0`}),_jsx(`th`,{style:{width:`9%`,whiteSpace:`nowrap`},children:`Level 1`}),_jsx(`th`,{style:{width:`10%`,whiteSpace:`nowrap`},children:`Level 2`})]})]}),_jsxs(`tbody`,{children:[_jsxs(`tr`,{children:[_jsx(`td`,{children:`The export button is misaligned by a few pixels on the settings page.`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`0.0`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{children:`The PDF export button does nothing when clicked. I can still export to CSV and convert it myself, but that takes ages.`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`0.0`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{children:`Export to PDF fails with a spinner that never finishes. Some of our team say CSV export still works for them, others say it fails too.`}),_jsx(`td`,{children:`1.11`}),_jsx(`td`,{children:`0.84`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`0.89`}),_jsx(`td`,{children:`0.11`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{children:`The export button crashes the settings page in Safari. It works in Chrome, but a few of our customers only use Safari.`}),_jsx(`td`,{children:`1.43`}),_jsx(`td`,{children:`0.35`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`0.57`}),_jsx(`td`,{children:`0.43`})]}),_jsxs(`tr`,{children:[_jsx(`td`,{children:`Nobody on our team can log in since this morning. We get a 500 error on every attempt.`}),_jsx(`td`,{children:`2.0`}),_jsx(`td`,{children:`1.0`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`0.0`}),_jsx(`td`,{children:`1.0`})]})]})]}),`\n`,_jsx(_components.p,{children:`In these examples, confidence 1.0 means the returned distribution puts all its probability on one level. This describes the model’s answer, not a guarantee that the answer is correct.`}),`\n`,_jsx(_components.p,{children:`The score is a probability-weighted mean of the level numbers. In the third and fourth examples, probability is split between levels 1 and 2. More weight on level 2 raises the score. It does not measure the fraction of customers without a workaround.`}),`\n`,_jsxs(_components.p,{children:[`Different distributions can produce the same score. A score of 1.0 can mean all probability is on level 1, or half is on each of levels 0 and 2. Read `,_jsx(_components.code,{children:`probabilities`}),` and `,_jsx(_components.code,{children:`confidence`}),` alongside the score to distinguish these cases.`]}),`\n`,_jsxs(_components.p,{children:[`A fractional score is a position. You can use it to rank reports by severity, or round it to the nearest level when your code needs one outcome. Our `,_jsx(_components.a,{href:`/cookbooks/entity_alignment`,children:`entity alignment cookbook`}),` shows an example of rounding to the nearest level to make a decision.`]}),`\n`,_jsxs(_components.p,{children:[`Low confidence on a Score usually means one of three things. The levels overlap for this state, the question is measuring more than one thing, or the state doesn’t say enough to place it. Our `,_jsx(_components.a,{href:`/confidence`,children:`Confidence`}),` docs cover how to use it in your code.`]}),`\n`,_jsx(Heading,{level:`2`,id:`writing-good-levels`,children:`Writing good levels`}),`\n`,_jsx(_components.p,{children:`Describe situations, not degrees. “Broken or degraded feature, but workaround exists” gives the model something to match the state against. “Moderately severe” doesn’t. Concrete descriptions can help the model distinguish levels. Check the answers against known examples; higher confidence alone does not show that a description is better.`}),`\n`,_jsx(_components.p,{children:`Every level is evaluated separately. The model doesn’t see a level’s number or its neighbours, so “worse than the previous level” means nothing to it, and numbers in the descriptions or the instructions don’t help. Here is what happens when the levels are only numbers, on the misaligned-button report from the table above:`}),`\n`,_jsx(CodeBlock,{numberOfLines:`4`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`4`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`instructions: \"Rate severity from 0 to 2, where 2 is worst\"`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`criteria: [\"0\", \"1\", \"2\"]`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`→ score 0.55, confidence 0.33, probabilities 0: 0.45, 1: 0.55, 2: 0.0`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(_components.p,{children:`The same report with the three descriptive levels scores 0.0 at confidence 1.0. With numbers only, the model has nothing to match against and splits the probability between 0 and 1.`}),`\n`,_jsx(_components.p,{children:`Use as many levels as you can describe distinctly, up to 10. Three is fine. Don’t add levels you can’t describe distinctly.`}),`\n`,_jsx(_components.p,{children:`Keep each Score question to one dimension. If a description says “punctual and smart and experienced”, the question is measuring three things, and an input that is high on one and low on another can’t be placed. Confidence drops and the score means less. Split it into one Score question per thing and combine them in code, as the next section shows.`}),`\n`,_jsx(_components.p,{children:`If the top of your scale has a rare extreme case you need to act on differently, give it its own level. A sentiment scale that ends at “very angry” can add “abusive or threatening”. Without that level, both messages may receive a score near the top. The score alone may not distinguish them.`}),`\n`,_jsxs(_components.p,{children:[`If there is no in-between at all, and the answer is one of a few discrete categories, use a `,_jsx(_components.a,{href:`/primitives/choice`,children:`Choice`}),` instead, or split the question into several `,_jsx(_components.a,{href:`/primitives/noul`,children:`Noul`}),` questions. It’s important to test your levels against your own data. Two wordings of the same scale can behave differently on your data.`]}),`\n`,_jsx(Heading,{level:`2`,id:`splitting-a-complex-judgment-into-several-score-questions`,children:`Splitting a complex judgment into several Score questions`}),`\n`,_jsxs(_components.p,{children:[`A complex judgment, one that depends on several things, is best split into one Score question per thing. You can then combine the Scores returned from TypeSafe in your code to make the judgment. Some Score questions may matter more than others, so give each Score question a weight for its relative importance. The weights are yours. When the combined result doesn’t match what your team would decide, change them in code and run again. Send the Score questions in one request. They are evaluated in parallel. Adding questions barely changes the response time and costs a few extra question tokens; see `,_jsx(_components.a,{href:`/primitives#ask-multiple-questions-together`,children:`Ask multiple questions together`}),`.`]}),`\n`,_jsx(_components.p,{children:`The request below is the spinner ticket from the table above with some more context. It asks three Score questions: how severe the bug is, how frustrated the customer is, and how much the report gives an engineer to work with.`}),`\n`,_jsx(_MdxComponentBoundary,{name:`TypesafeExample`,children:_jsx(TypesafeExample,{display:`request`,example:{state:`Export to PDF fails with a spinner that never finishes. Some of our team say CSV export still works for them, others say it fails too. This is the third time I'm writing in and honestly I'm done. Steps: open any report, click Export, choose PDF. Chrome 128 on macOS.`,selectedModels:[`jev-latest`],questions:{severity:{type:`score`,instructions:`How severe is the reported issue?`,criteria:[`Cosmetic; no impact to functionality`,`Broken or degraded feature, but workaround exists`,`Blocking issue; no workaround exists`]},frustration:{type:`score`,instructions:`How frustrated is the customer?`,criteria:[`Calm, just stating facts`,`Frustrated but civil`,`Very angry, strong language or threatening to leave`]},report_quality:{type:`score`,instructions:`How much does the report give an engineer to work with?`,criteria:[`No detail; just says something is broken`,`Names the feature but no steps or environment`,`Steps to reproduce or environment, but not both`,`Steps to reproduce and environment`]}}}})}),`\n`,_jsx(_components.p,{children:`TypeSafe’s response:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`56`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`56`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className: