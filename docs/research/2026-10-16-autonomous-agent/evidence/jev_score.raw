#article","headline":"Score","name":"Score","description":"A Score is a System One question type for rating content against ordered, descriptive levels. The answer includes a score, a probability for each level, and confidence.","url":"https://docs.typesafe.ai/primitives/score","mainEntityOfPage":{"@id":"https://docs.typesafe.ai/primitives/score#webpage"},"dateModified":"2026-09-20T02:53:36.023Z","publisher":{"@id":"https://docs.typesafe.ai/#organization"},"isPartOf":{"@id":"https://docs.typesafe.ai#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="styles.css">/* Accent token shared by diagrams and interactive widgets. #E551BA is the
   brand pink from docs.json. */
:root {
  --ts-accent: #E551BA;
}

/* Widen the main content column (Mintlify default: 696px). The margin-left
   mirrors Mintlify's own centering formula (50vw - half content width - the
   18rem left sidebar) so the column stays visually centered at xl widths.
   Skipped in custom page mode (the 404 page), which has no sidebar: the
   offset would push the content 18rem left of center. */
@media (min-width: 1024px) {
  html:not([data-page-mode="custom"]) #content-area {
    max-width: 816px;
  }
}
@media (min-width: 1280px) {
  html:not([data-page-mode="custom"]) #content-area {
    margin-left: max(0px, calc(50vw - 408px - 18rem));
  }
}

#page-title {
  font-size: 3.85rem;
  font-weight: 500;
  line-height: 95%;
  letter-spacing: -0.04em;
  padding-bottom: 0.2rem;
}

/* Keep the primary topbar button text white */
[data-component-name="primary-header-button"],
[data-component-name="primary-header-button"] * {
  color: #FFFFFF !important;
}

h2, h3, h4, h5, h6 {
  padding-top:2rem;
  padding-bottom:0.5rem;
  margin:0;
  font-weight:500;
}
.dark h1 {
  opacity: 88%;
}
.dark h2, .dark h3, .dark h4, .dark h5, .dark h6 {
  color: color-mix(in srgb, #F9F6F9 70%, transparent);
}

/* Get rid of all border radius: callouts, buttons, cards, search boxes, code blocks, and selected sidebar items.
but preserve circular icons and avatars */
/* Remove border radius while preserving circular icons and avatars */
.callout,
.accordion,
.accordion-group,
.frame,
.frame > div,
.frame img,
.expandable,
.expandable *,
#sidebar-content a,
#search-bar-entry,
#navbar button,
#navbar a,
#pagination a,
#page-context-menu button,
.card,
.code-group,
.code-group *,
.code-block,
.code-block * {
  border-radius: 0 !important;
  --rounded-xl: 0px;
}

/* Remove CodeGroup's internal tab-panel radius token. */
.code-group {
  
}

/* SIMPLIFY COPY PAGE BUTTON */
/* Page actions popup. Mintlify portals it into body, outside
   #page-context-menu, so these rules do not alter the split-button trigger. */
body:has(#page-context-menu [aria-expanded="true"]) [role="menu"] {
  border-radius: 0 !important;
  font-family: inherit;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5;
}
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] {
  border-radius: 0 !important;
  padding: 0.5rem 0.75rem;
  font: inherit;
}
/* Each item contains an icon box, then a label/description column. */
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] > div:first-child,
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] svg,
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] > div:nth-child(2) > div + div {
  display: none;
}
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] > div:nth-child(2) {
  padding: 0;
}
body:has(#page-context-menu [aria-expanded="true"]) [role="menuitem"] > div:nth-child(2) > div:first-child {
  font: inherit;
}

/* eyebrow header styling */
.sidebar-group-header,
#header .eyebrow,
.code-block [data-component-part="code-block-header-filename"] {
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: color-mix(in srgb, #111111 55%, transparent) !important;
}
.dark .sidebar-group-header,
.dark #header .eyebrow,
.dark .code-block [data-component-part="code-block-header-filename"] {
  letter-spacing: 0.09em;
  color: color-mix(in srgb, #F9F6F9 70%, transparent) !important;
  opacity: 65%
}

/* SIDEBAR: selected menu item bg */
#sidebar-content li[data-active] > a {
  background-color: #F9F6F9;
}
.dark #sidebar-content li[data-active] > a {
  background-color: color-mix(in srgb, #2C272B 60%, transparent);
} 

/* ----------------BADGES---------------- */
/* Inline code and API type code snippets */
#content :not(pre) > code,
#content [data-component-part="field-info-pill"] {
  background-color: #F5F0F3 !important;
  border: 1px solid color-mix(in srgb, #A5A0A4 15%, transparent) !important; 
}
.dark #content :not(pre) > code,
.dark #content [data-component-part="field-info-pill"] {
  background-color: color-mix(in srgb, #2C272B 60%, transparent) !important;
}
/* API REQUIRED BADGE */
[data-component-part="field-required-pill"] {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  color: #F9F6F9 !important;
  background-color: #111111 !important;
  /* border:  1px solid #F9F6F9; */
  border-radius: 0px !important;
  padding-right: 6px;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.dark [data-component-part="field-required-pill"] {
  color: #111111 !important;
  background-color: color-mix(in srgb, #F9F6F9 80%, transparent) !important;
}

/* SIDEBAR NAV TAG BADGES
   Edit these variables independently from API field pills and inline code. */
#sidebar-content .nav-tag-pill-text[data-nav-tag] {
  color: var(--nav-tag-text) !important;
  background-color: var(--nav-tag-bg) !important;
  font-weight: 600;
  border-radius: 0 !important;
}

/* Beginner — light */
#sidebar-content .nav-tag-pill-text[data-nav-tag="Beginner"] {
  --nav-tag-bg: color-mix(in srgb, #9AD1F5 33%, transparent) !important;
  --nav-tag-text: #065A91;
}
.dark #sidebar-content .nav-tag-pill-text[data-nav-tag="Beginner"] {
  --nav-tag-bg: color-mix(in srgb, #4B5FD6 28%, transparent) !important;
  --nav-tag-text: color-mix(in srgb, #4B5FD6 40%, #9AD1F5) !important;
}
/* Intermediate — light */
#sidebar-content .nav-tag-pill-text[data-nav-tag="Intermediate"] {
  --nav-tag-bg: color-mix(in srgb, #B6E88E 50%, transparent) !important;
  --nav-tag-text: #245b08;
}
.dark #sidebar-content .nav-tag-pill-text[data-nav-tag="Intermediate"] {
  --nav-tag-bg:  color-mix(in srgb, #245b08 33%, transparent) !important;
  --nav-tag-text: color-mix(in srgb, #B6E88E 60%, #245b08) !important;
  
}
/* Advanced — light */
#sidebar-content .nav-tag-pill-text[data-nav-tag="Advanced"] {
  --nav-tag-bg: color-mix(in srgb, #FF71DF 20%, transparent) !important;
  --nav-tag-text: #A42D71;
}
.dark #sidebar-content .nav-tag-pill-text[data-nav-tag="Advanced"] {
  --nav-tag-bg: color-mix(in srgb, #FF71DF 20%, transparent) !important;
  --nav-tag-text: color-mix(in srgb, #A42D71 15%, #F386A1) !important;
}

/* CALLOUT BOXES STYLING */
/* Note — light */
.callout[data-callout-type="note"] {
  --callout-bg: #EFF6FF;
  --callout-border: #BFDBFE;
  --callout-text: #1E40AF;
}
.dark .callout[data-callout-type="note"] {
  --callout-bg: #2563EB33;
  --callout-border: #1E3A8A;
  --callout-text: #93C5FD;
}
/* Warning — light */
.callout[data-callout-type="warning"] {
  --callout-bg: #FEFCE8;
  --callout-border: #FEF08A;
  --callout-text: #854D0E;
}
.dark .callout[data-callout-type="warning"] {
  --callout-bg: #CA8A0433;
  --callout-border: #713F12;
  --callout-text: #FDE047;
}
/* Info — light */
.callout[data-callout-type="info"] {
  --callout-bg: #FAFAFA;
  --callout-border: #E5E5E5;
  --callout-text: #262626;
}
.dark .callout[data-callout-type="info"] {
  --callout-bg: #FFFFFF1A;
  --callout-border: #404040;
  --callout-text: #D4D4D4;
}
/* Tip — light */
.callout[data-callout-type="tip"] {
  --callout-bg: #F0FDF4;
  --callout-border: #BBF7D0;
  --callout-text: #166534;
}
.dark .callout[data-callout-type="tip"] {
  --callout-bg: #16A34A33;
  --callout-border: #14532D;
  --callout-text: #86EFAC;
}
/* Check — light */
.callout[data-callout-type="check"] {
  --callout-bg: #F0FDF4;
  --callout-border: #BBF7D0;
  --callout-text: #166534;
}
.dark .callout[data-callout-type="check"] {
  --callout-bg: #16A34A33;
  --callout-border: #14532D;
  --callout-text: #86EFAC;
}
/* Danger — light */
.callout[data-callout-type="danger"] {
  --callout-bg: #FEF2F2;
  --callout-border: #FECACA;
  --callout-text: #991B1B;
}
.dark .callout[data-callout-type="danger"] {
  --callout-bg: #DC262633;
  --callout-border: #7F1D1D;
  --callout-text: #FCA5A5;
}
/* ------------------------------------------------------ */
/* Apply the variables without changing spacing or layout */
.callout[data-callout-type] {
  background-color: var(--callout-bg);
  border-color: var(--callout-border);
}

.callout[data-callout-type]
  [data-component-part="callout-content"],
.callout[data-callout-type]
  [data-component-part="callout-icon"] svg {
  color: var(--callout-text);
}

/* PAGINATION (PREV/NEXT) */
/* Pagination colors — light */
#pagination {
  /* --pagination-bg: #F9F6F9;
  --pagination-border: #E5DFE4;
  --pagination-title: #1D191C;*/
  --pagination-label: #E551BA; 
  --pagination-arrow: #E551BA;
}
.dark #pagination {
  /* --pagination-bg: #151215;
  --pagination-border: #302A2F;
  --pagination-title: #F9F6F9;*/
  --pagination-label: #E551BA; 
  --pagination-arrow: #E551BA;
}

/* Previous and Next boxes */
#pagination [data-component-part="pagination-prev"],
#pagination [data-component-part="pagination-next"] {
  /* background-color: var(--pagination-bg) !important; */
  /* border-color: var(--pagination-border) !important; */
  /* padding: 1rem 1.25rem; */
}

/* Page names: Choice and Noul */
#pagination [data-component-part="pagination-title"] {
  /* color: var(--pagination-title) !important;
  font-size: 1rem; */
  font-weight: 400;
  opacity: 75%

}

/* Previous and Next labels */
#pagination [data-component-part="pagination-label"] {
  color: var(--pagination-label) !important;
}

/* Arrow icons */
#pagination [data-component-part="pagination-chevron"] {
  color: var(--pagination-arrow) !important;
}

/* Hover state */
#pagination a:hover {
  background-color: #F5F0F3;;
}
.dark #pagination a:hover {
  background-color: color-mix(in srgb, #2C272B 60%, transparent);

}

/* ---------------- MERMAID DIAGRAMS ----------------
   [data-component-name^="mermaid-"] matches both the inline diagram
   ("mermaid-container") and the fullscreen view ("mermaid-fullscreen-modal"),
   which renders a second copy of the SVG outside the container. */

/* Hover controls: keep only the fullscreen button, square everything. */
[data-component-name="mermaid-container"] > .grid {
  display: block;
}
[data-component-name="mermaid-container"] > .grid > button:not([aria-label="Open fullscreen"]) {
  display: none;
}
[data-component-name^="mermaid-"] button,
[data-component-name^="mermaid-"] span {
  border-radius: 0 !important;
}

/* Touch users need a visible fullscreen button. Put it below the diagram so
   the larger tap target does not cover nodes in a small preview. */
@media (max-width: 767px), (hover: none), (pointer: coarse) {
  [data-component-name="mermaid-container"] {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  [data-component-name="mermaid-container"] > [data-component-name="mermaid-controls-wrapper"] {
    position: static;
    order: 1;
    align-self: flex-end;
    opacity: 1;
    pointer-events: auto;
  }
  [data-component-name^="mermaid-"] button {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    margin: 6px;
  }
  [data-component-name^="mermaid-"] button:not([aria-label="Close fullscreen"]) {
    position: relative;
  }
  /* Extend through the 1px border into the 6px margin: a 44px tap target. */
  [data-component-name^="mermaid-"] button::after {
    content: "";
    position: absolute;
    inset: -7px;
  }
}

/* Palette. One accent, the brand pink, marks the TypeSafe boundary: the
   subgraph and its heading. Everything else is neutral zinc, the same greys
   the interactive widgets use, so diagrams read like the rest of the page in
   both themes. Without these rules light mode falls back to mermaid's stock
   theme (lavender nodes, yellow subgraphs) and dark mode to Mintlify's flat
   grey theme. Per-diagram classDef colours still win, because mermaid writes
   them as inline !important styles.

   Contrast (WCAG AA): text is at least 4.5:1 and lines at least 3:1 against
   the page in each theme. Pink is used for strokes and fills only, never for
   diagram text: brand pink #E551BA is 3.4:1 on white. */
[data-component-name^="mermaid-"] {
  --mermaid-accent: var(--ts-accent);
  --mermaid-accent-fill: color-mix(in srgb, var(--ts-accent) 7%, transparent);
  --mermaid-node-fill: #ffffff;
  --mermaid-node-stroke: #27272a; /* zinc-800, same as node text */
  --mermaid-text: #27272a;        /* zinc-800 */
  --mermaid-muted: #52525b;       /* zinc-600, 7.7:1 on white */
  --mermaid-line: #71717a;        /* zinc-500 */
  --mermaid-label-bg: rgb(var(--background-light));
}
.dark [data-component-name^="mermaid-"] {
  --mermaid-accent-fill: color-mix(in srgb, var(--ts-accent) 10%, transparent);
  --mermaid-node-fill: rgb(var(--background-dark)); /* page colour, as white is in light mode */
  --mermaid-node-stroke: #ffffff;
  --mermaid-text: #fafafa;        /* zinc-50 */
  --mermaid-muted: #d4d4d8;       /* zinc-300, edge labels */
  --mermaid-line: #a1a1aa;
  --mermaid-label-bg: rgb(var(--background-dark));
}
[data-component-name^="mermaid-"] :is(.node rect, .node circle, .node ellipse, .node polygon, .node path) {
  fill: var(--mermaid-node-fill) !important;
  stroke: var(--mermaid-node-stroke) !important;
  stroke-width: 1px !important;
}
[data-component-name^="mermaid-"] .cluster rect {
  fill: var(--mermaid-accent-fill) !important;
  stroke: var(--mermaid-accent) !important;
  stroke-width: 1.5px !important;
}
[data-component-name^="mermaid-"] :is(.nodeLabel, .nodeLabel p, .label text) {
  color: var(--mermaid-text) !important;
  fill: var(--mermaid-text) !important;
}
/* The subgraph heading uses the ordinary text colour: the pink border and
   tint already mark the TypeSafe boundary, and plain text reads better on the
   tint (13:1 in dark mode) than pink (5.3:1). Do not add font-weight here: a
   heavier weight would outgrow the box mermaid measured. */
[data-component-name^="mermaid-"] .cluster-label :is(.nodeLabel, p) {
  color: var(--mermaid-text) !important;
}
/* linkStyle writes a plain inline stroke:none (no !important), so leave those
   links alone or the !important below would make hidden edges visible. */
[data-component-name^="mermaid-"] :is(.flowchart-link:not([style*="stroke:none"]), .marker) {
  stroke: var(--mermaid-line) !important;
}
[data-component-name^="mermaid-"] .marker {
  fill: var(--mermaid-line) !important;
}

/* Edge labels sit on the arrow, so their background is the page background
   (Mintlify's own variables) rather than a grey pill. */
[data-component-name^="mermaid-"] :is(.edgeLabel p, .edgeLabel span) {
  color: var(--mermaid-muted) !important;
  background-color: var(--mermaid-label-bg) !important;
}
/* Mermaid's dark theme paints the label wrapper a translucent grey. It is a
   little larger than the span, so it showed as a thin frame around the text. */
[data-component-name^="mermaid-"] .labelBkg {
  background-color: var(--mermaid-label-bg) !important;
}
[data-component-name^="mermaid-"] .edgeLabel rect {
  fill: var(--mermaid-label-bg) !important;
}

/* ---------------- MERMAID: NEON SIGNAL (dark mode only) ----------------
   Proposed by the TypeSafe team. All rules in this block are under .dark.
   Light mode gets the same branch colours, in darker shades and without
   the glow, in the BRANCHES (light mode) block below.

   The palette is pink and neutral. All lines glow: node borders, edges,
   arrowheads, and the pink TypeSafe subgraph. Decision diamonds get a
   thicker border. Plain shapes have the page colour as fill.

   Branch colours. A diagram with a routing decision colours the branches
   after it. Green and red are state colours, reserved for success and
   error. The other colours are labels. The meaning is the same in every
   diagram:
     green  - proceeds to an automated handler (success)
     red    - error, or not confident enough
     blue   - goes to a person (human agent, review, confirmation)
     purple - stops (block, drop, leave unlinked)
     orange - another automated path, secondary to the main one
              (billing, crisis support, conflicting evidence)
   Green marks the branch by where it goes, not by the word on the edge:
   a "no" that proceeds to a handler is green.
   A confidence gate is different. Its branches read as a gradient in
   rainbow order: red, orange, yellow, green from the lowest branch to the
   highest. A gate with more branches continues the rainbow: blue, indigo,
   violet.
   A diagram with no confidence test, such as fan-out, is also different.
   Its branches are categories, not states, so the colours are labels only
   and it uses no green.
   In the diagram source, give the node `class <node> neonGreen`. Give the
   edge an id with the colour as prefix: `gate green_ok@-- "yes" --> ok`.
   Mermaid writes the edge id on the path and on the label, so one rule per
   colour covers the node, the edge, the label, and the arrowhead.

   Contrast on the dark page (#0d0a0f): white text 19:1, zinc-200 lines
   15.5:1, green-400 11.3:1, blue-400 7.7:1, purple-400 8.2:1,
   orange-400 8.7:1, red-400 7.1:1, yellow-400 12.8:1. */
.dark [data-component-name^="mermaid-"] {
  --neon-line: #e4e4e7;   /* zinc-200: node borders and edges */
  --neon-green: #4ade80;  /* green-400 */
  --neon-blue: #60a5fa;   /* blue-400 */
  --neon-purple: #c084fc; /* purple-400 */
  --neon-yellow: #facc15; /* yellow-400 */
  --neon-orange: #fb923c; /* orange-400 */
  --neon-red: #f87171;    /* red-400 */
  --mermaid-text: #ffffff;
  --mermaid-muted: #e4e4e7; /* zinc-200, edge labels */
  --mermaid-line: var(--neon-line);
}
.dark [data-component-name^="mermaid-"] :is(.node rect, .node circle, .node ellipse, .node polygon, .node path) {
  --neon: var(--neon-line);
  fill: rgb(var(--background-dark)) !important;
  stroke: var(--neon) !important;
  stroke-width: 1.5px !important;
  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 60%, transparent));
}
.dark [data-component-name^="mermaid-"] .node polygon {
  stroke-width: 2px !important;
  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 60%, transparent));
}
/* The TypeSafe subgraph keeps its pink boundary. */
.dark [data-component-name^="mermaid-"] .cluster rect {
  fill: color-mix(in srgb, var(--mermaid-accent) 14%, rgb(var(--background-dark))) !important;
  stroke: var(--mermaid-accent) !important;
  stroke-width: 1.5px !important;
  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--mermaid-accent) 55%, transparent));
}
/* A subgraph that is not TypeSafe opts out with `style X fill:none,...`.
   Mermaid writes that inline, so it wins over the fill and stroke above,
   but not over the filter. Drop the pink glow too. */
.dark [data-component-name^="mermaid-"] .cluster rect[style*="fill:none"] {
  filter: none;
}
/* All edges glow. linkStyle hides some edges with an inline stroke:none. */
.dark [data-component-name^="mermaid-"] .flowchart-link:not([style*="stroke:none"]) {
  --neon: var(--neon-line);
  stroke: var(--neon) !important;
  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 55%, transparent));
}
/* Arrowheads take the colour of their edge. Browsers without
   context-stroke keep the plain line colour. */
.dark [data-component-name^="mermaid-"] .marker {
  fill: var(--mermaid-line) !important;
  stroke: var(--mermaid-line) !important;
  fill: context-stroke !important;
  stroke: context-stroke !important;
}
/* Branches: node classes, edge id prefixes, and edge labels.
   Branch shapes get a light tint of their colour. */
.dark [data-component-name^="mermaid-"] .node.neonGreen :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-green); }
.dark [data-component-name^="mermaid-"] .node.neonBlue :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-blue); }
.dark [data-component-name^="mermaid-"] .node.neonPurple :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-purple); }
.dark [data-component-name^="mermaid-"] .node.neonYellow :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-yellow); }
.dark [data-component-name^="mermaid-"] .node.neonOrange :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-orange); }
.dark [data-component-name^="mermaid-"] .node.neonRed :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-red); }
.dark [data-component-name^="mermaid-"] :is(.node.neonGreen, .node.neonBlue, .node.neonPurple, .node.neonYellow, .node.neonOrange, .node.neonRed) :is(rect, circle, ellipse, polygon, path) {
  fill: color-mix(in srgb, var(--neon) 12%, rgb(var(--background-dark))) !important;
}
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-green_"] { --neon: var(--neon-green); }
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-blue_"] { --neon: var(--neon-blue); }
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-purple_"] { --neon: var(--neon-purple); }
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-yellow_"] { --neon: var(--neon-yellow); }
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-orange_"] { --neon: var(--neon-orange); }
.dark [data-component-name^="mermaid-"] .flowchart-link[id*="-red_"] { --neon: var(--neon-red); }
.dark [data-component-name^="mermaid-"] .label[data-id^="green_"] .edgeLabel p { color: var(--neon-green) !important; }
.dark [data-component-name^="mermaid-"] .label[data-id^="blue_"] .edgeLabel p { color: var(--neon-blue) !important; }
.dark [data-component-name^="mermaid-"] .label[data-id^="purple_"] .edgeLabel p { color: var(--neon-purple) !important; }
.dark [data-component-name^="mermaid-"] .label[data-id^="yellow_"] .edgeLabel p { color: var(--neon-yellow) !important; }
.dark [data-component-name^="mermaid-"] .label[data-id^="orange_"] .edgeLabel p { color: var(--neon-orange) !important; }
.dark [data-component-name^="mermaid-"] .label[data-id^="red_"] .edgeLabel p { color: var(--neon-red) !important; }

/* ---------------- MERMAID: BRANCHES (light mode) ----------------
   The same branch colours and meanings as the dark-mode block, in darker
   shades. No glow: it looks wrong on white.

   Contrast on white (WCAG AA, 4.5:1 for label text): green-700 5.0:1,
   green-700 5.0:1, blue-700 6.7:1, purple-700 7.0:1, orange-700 5.2:1,
   red-700 6.5:1, yellow-700 4.9:1. */
:root:not(.dark) [data-component-name^="mermaid-"] {
  --neon-green: #15803d;  /* green-700 */
  --neon-blue: #1d4ed8;   /* blue-700 */
  --neon-purple: #7e22ce; /* purple-700 */
  --neon-yellow: #a16207; /* yellow-700 */
  --neon-orange: #c2410c; /* orange-700 */
  --neon-red: #b91c1c;    /* red-700 */
}
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonGreen :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-green); }
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonBlue :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-blue); }
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonPurple :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-purple); }
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonYellow :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-yellow); }
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonOrange :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-orange); }
:root:not(.dark) [data-component-name^="mermaid-"] .node.neonRed :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-red); }
:root:not(.dark) [data-component-name^="mermaid-"] :is(.node.neonGreen, .node.neonBlue, .node.neonPurple, .node.neonYellow, .node.neonOrange, .node.neonRed) :is(rect, circle, ellipse, polygon, path) {
  fill: color-mix(in srgb, var(--neon) 7%, #ffffff) !important;
  stroke: var(--neon) !important;
  stroke-width: 1.5px !important;
}
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-green_"] { --neon: var(--neon-green); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-blue_"] { --neon: var(--neon-blue); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-purple_"] { --neon: var(--neon-purple); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-yellow_"] { --neon: var(--neon-yellow); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-orange_"] { --neon: var(--neon-orange); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link[id*="-red_"] { --neon: var(--neon-red); }
:root:not(.dark) [data-component-name^="mermaid-"] .flowchart-link:is([id*="-green_"], [id*="-blue_"], [id*="-purple_"], [id*="-yellow_"], [id*="-orange_"], [id*="-red_"]) {
  stroke: var(--neon) !important;
}
:root:not(.dark) [data-component-name^="mermaid-"] .marker {
  fill: var(--mermaid-line) !important;
  stroke: var(--mermaid-line) !important;
  fill: context-stroke !important;
  stroke: context-stroke !important;
}
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="green_"] .edgeLabel p { color: var(--neon-green) !important; }
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="blue_"] .edgeLabel p { color: var(--neon-blue) !important; }
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="purple_"] .edgeLabel p { color: var(--neon-purple) !important; }
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="yellow_"] .edgeLabel p { color: var(--neon-yellow) !important; }
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="orange_"] .edgeLabel p { color: var(--neon-orange) !important; }
:root:not(.dark) [data-component-name^="mermaid-"] .label[data-id^="red_"] .edgeLabel p { color: var(--neon-red) !important; }

/* ---------------- MERMAID: LINE JUNCTION ----------------
   introduction.mdx joins two lines into one request through an f-circ
   node. Mermaid ends all three edges on that node's 14px circle, which
   leaves a hole: a dot big enough to fill it is bigger than the lines.
   So redraw the shape as the three short arms that bridge the hole. The
   lines meet and there is no dot. Browsers without CSS `d` keep the
   circle, outlined in the line colour. :root outranks the neon block. */
:root [data-component-name^="mermaid-"] .node.junction path {
  d: path("M -2 -7 L 0 0 L -2 7 M 0 0 L 7 0");
  stroke: var(--mermaid-line) !important;
}
