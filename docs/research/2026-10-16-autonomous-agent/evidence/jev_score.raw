#installation`,children:`TypeSafe agent skill`}),` first so it knows the request and response shapes.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[_jsx(_components.code,{children:`instructions`}),` and each level in `,_jsx(_components.code,{children:`criteria`}),` can be a string, an object, or an array. Start with strings. Use an object when a level needs a description plus a few example situations. See `,_jsx(_components.a,{href:`#structured-level-descriptions`,children:`Structured level descriptions`}),` below and the `,_jsx(_components.a,{href:`/api#param-instructions-2`,children:`API reference`}),`.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`response-structure`,children:`Response structure`}),`\n`,_jsxs(_components.p,{children:[`The response has one entry in `,_jsx(_components.code,{children:`answers`}),` per question, under the ids from the request. This is the response to the example request above:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`24`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`24`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"model\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"jev-1.13.0\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDC