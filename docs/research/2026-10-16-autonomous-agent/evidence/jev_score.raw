<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">            &quot;Steps to reproduce and environment&quot;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">,</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">        ],</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">    ),</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">}</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#569CD6">def</span><span style="color:#8250DF;--shiki-dark:#DCDCAA"> normalized</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">(</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">answers</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">, </span><span style="color:#1F2328;--shiki-dark:#9CDCFE">question_id</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0550AE;--shiki-dark:#4EC9B0">str</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">) -&gt; </span><span style="color:#0550AE;--shiki-dark:#4EC9B0">float</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">:</span></span>
<span class="line"><span style="color:#0A3069;--shiki-dark:#CE9178">    &quot;&quot;&quot;Put a score on 0 to 1 by dividing by its top level number.&quot;&quot;&quot;</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">    top_level </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0550AE;--shiki-dark:#DCDCAA"> len</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">(</span><span style="color:#0550AE;--shiki-dark:#D4D4D4">TRIAGE_QUESTIONS</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">[question_id].criteria) </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">-</span><span style="color:#0550AE;--shiki-dark:#B5CEA8"> 1</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#C586C0">    return</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> answers[question_id].score </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">/</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> top_level</span></span>
<span class="line"></span>
<span class="line"></span>
