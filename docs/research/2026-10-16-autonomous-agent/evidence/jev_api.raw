tJDD7Q\",\"/mintlify-assets/_next/static/chunks/2f482bcd3294a910.js?dpl=dpl_EFphLEJeewGjC2efg7rUSgtJDD7Q\",\"/mintlify-assets/_next/static/chunks/3d4550911741fe33.js?dpl=dpl_EFphLEJeewGjC2efg7rUSgtJDD7Q\",\"/mintlify-assets/_next/static/chunks/e7ab3f319130be21.js?dpl=dpl_EFphLEJeewGjC2efg7rUSgtJDD7Q\",\"/mintlify-assets/_next/static/chunks/67122d2cabb5f5fb.js?dpl=dpl_EFphLEJeewGjC2efg7rUSgtJDD7Q\",\"/mintlify-assets/_next/static/chunks/0dc05d97594e73a1.js?dpl=dpl_EFphLEJeewGjC2efg7rUSgtJDD7Q\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"51:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L56\",null,{\"pageMetadata\":\"$4a:props:pageMetadata\"}]]\n52:[\"$\",\"$L57\",null,{\"pageMetadata\":\"$4a:props:pageMetadata\"}]\n59:T66bb,"])</script><script>self.__next_f.push([1,"/* Accent token shared by diagrams and interactive widgets. #E551BA is the\n   brand pink from docs.json. */\n:root {\n  --ts-accent: #E551BA;\n}\n\n/* Widen the main content column (Mintlify default: 696px). The margin-left\n   mirrors Mintlify's own centering formula (50vw - half content width - the\n   18rem left sidebar) so the column stays visually centered at xl widths.\n   Skipped in custom page mode (the 404 page), which has no sidebar: the\n   offset would push the content 18rem left of center. */\n@media (min-width: 1024px) {\n  html:not([data-page-mode=\"custom\"]) #content-area {\n    max-width: 816px;\n  }\n}\n@media (min-width: 1280px) {\n  html:not([data-page-mode=\"custom\"]) #content-area {\n    margin-left: max(0px, calc(50vw - 408px - 18rem));\n  }\n}\n\n#page-title {\n  font-size: 3.85rem;\n  font-weight: 500;\n  line-height: 95%;\n  letter-spacing: -0.04em;\n  padding-bottom: 0.2rem;\n}\n\n/* Keep the primary topbar button text white */\n[data-component-name=\"primary-header-button\"],\n[data-component-name=\"primary-header-button\"] * {\n  color: #FFFFFF !important;\n}\n\nh2, h3, h4, h5, h6 {\n  padding-top:2rem;\n  padding-bottom:0.5rem;\n  margin:0;\n  font-weight:500;\n}\n.dark h1 {\n  opacity: 88%;\n}\n.dark h2, .dark h3, .dark h4, .dark h5, .dark h6 {\n  color: color-mix(in srgb, #F9F6F9 70%, transparent);\n}\n\n/* Get rid of all border radius: callouts, buttons, cards, search boxes, code blocks, and selected sidebar items.\nbut preserve circular icons and avatars */\n/* Remove border radius while preserving circular icons and avatars */\n.callout,\n.accordion,\n.accordion-group,\n.frame,\n.frame \u003e div,\n.frame img,\n.expandable,\n.expandable *,\n#sidebar-content a,\n#search-bar-entry,\n#navbar button,\n#navbar a,\n#pagination a,\n#page-context-menu button,\n.card,\n.code-group,\n.code-group *,\n.code-block,\n.code-block * {\n  border-radius: 0 !important;\n  --rounded-xl: 0px;\n}\n\n/* Remove CodeGroup's internal tab-panel radius token. */\n.code-group {\n  \n}\n\n/* SIMPLIFY COPY PAGE BUTTON */\n/* Page actions popup. Mintlify portals it into body, outside\n   #page-context-menu, so these rules do not alter the split-button trigger. */\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menu\"] {\n  border-radius: 0 !important;\n  font-family: inherit;\n  font-size: 1rem;\n  font-weight: 400;\n  line-height: 1.5;\n}\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] {\n  border-radius: 0 !important;\n  padding: 0.5rem 0.75rem;\n  font: inherit;\n}\n/* Each item contains an icon box, then a label/description column. */\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] \u003e div:first-child,\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] svg,\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] \u003e div:nth-child(2) \u003e div + div {\n  display: none;\n}\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] \u003e div:nth-child(2) {\n  padding: 0;\n}\nbody:has(#page-context-menu [aria-expanded=\"true\"]) [role=\"menuitem\"] \u003e div:nth-child(2) \u003e div:first-child {\n  font: inherit;\n}\n\n/* eyebrow header styling */\n.sidebar-group-header,\n#header .eyebrow,\n.code-block [data-component-part=\"code-block-header-filename\"] {\n  font-size: 0.6875rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: color-mix(in srgb, #111111 55%, transparent) !important;\n}\n.dark .sidebar-group-header,\n.dark #header .eyebrow,\n.dark .code-block [data-component-part=\"code-block-header-filename\"] {\n  letter-spacing: 0.09em;\n  color: color-mix(in srgb, #F9F6F9 70%, transparent) !important;\n  opacity: 65%\n}\n\n/* SIDEBAR: selected menu item bg */\n#sidebar-content li[data-active] \u003e a {\n  background-color: #F9F6F9;\n}\n.dark #sidebar-content li[data-active] \u003e a {\n  background-color: color-mix(in srgb, #2C272B 60%, transparent);\n} \n\n/* ----------------BADGES---------------- */\n/* Inline code and API type code snippets */\n#content :not(pre) \u003e code,\n#content [data-component-part=\"field-info-pill\"] {\n  background-color: #F5F0F3 !important;\n  border: 1px solid color-mix(in srgb, #A5A0A4 15%, transparent) !important; \n}\n.dark #content :not(pre) \u003e code,\n.dark #content [data-component-part=\"field-info-pill\"] {\n  background-color: color-mix(in srgb, #2C272B 60%, transparent) !important;\n}\n/* API REQUIRED BADGE */\n[data-component-part=\"field-required-pill\"] {\n  font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif !important;\n  color: #F9F6F9 !important;\n  background-color: #111111 !important;\n  /* border:  1px solid #F9F6F9; */\n  border-radius: 0px !important;\n  padding-right: 6px;\n  font-size: 0.6875rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n.dark [data-component-part=\"field-required-pill\"] {\n  color: #111111 !important;\n  background-color: color-mix(in srgb, #F9F6F9 80%, transparent) !important;\n}\n\n/* SIDEBAR NAV TAG BADGES\n   Edit these variables independently from API field pills and inline code. */\n#sidebar-content .nav-tag-pill-text[data-nav-tag] {\n  color: var(--nav-tag-text) !important;\n  background-color: var(--nav-tag-bg) !important;\n  font-weight: 600;\n  border-radius: 0 !important;\n}\n\n/* Beginner — light */\n#sidebar-content .nav-tag-pill-text[data-nav-tag=\"Beginner\"] {\n  --nav-tag-bg: color-mix(in srgb, #9AD1F5 33%, transparent) !important;\n  --nav-tag-text: #065A91;\n}\n.dark #sidebar-content .nav-tag-pill-text[data-nav-tag=\"Beginner\"] {\n  --nav-tag-bg: color-mix(in srgb, #4B5FD6 28%, transparent) !important;\n  --nav-tag-text: color-mix(in srgb, #4B5FD6 40%, #9AD1F5) !important;\n}\n/* Intermediate — light */\n#sidebar-content .nav-tag-pill-text[data-nav-tag=\"Intermediate\"] {\n  --nav-tag-bg: color-mix(in srgb, #B6E88E 50%, transparent) !important;\n  --nav-tag-text: #245b08;\n}\n.dark #sidebar-content .nav-tag-pill-text[data-nav-tag=\"Intermediate\"] {\n  --nav-tag-bg:  color-mix(in srgb, #245b08 33%, transparent) !important;\n  --nav-tag-text: color-mix(in srgb, #B6E88E 60%, #245b08) !important;\n  \n}\n/* Advanced — light */\n#sidebar-content .nav-tag-pill-text[data-nav-tag=\"Advanced\"] {\n  --nav-tag-bg: color-mix(in srgb, #FF71DF 20%, transparent) !important;\n  --nav-tag-text: #A42D71;\n}\n.dark #sidebar-content .nav-tag-pill-text[data-nav-tag=\"Advanced\"] {\n  --nav-tag-bg: color-mix(in srgb, #FF71DF 20%, transparent) !important;\n  --nav-tag-text: color-mix(in srgb, #A42D71 15%, #F386A1) !important;\n}\n\n/* CALLOUT BOXES STYLING */\n/* Note — light */\n.callout[data-callout-type=\"note\"] {\n  --callout-bg: #EFF6FF;\n  --callout-border: #BFDBFE;\n  --callout-text: #1E40AF;\n}\n.dark .callout[data-callout-type=\"note\"] {\n  --callout-bg: #2563EB33;\n  --callout-border: #1E3A8A;\n  --callout-text: #93C5FD;\n}\n/* Warning — light */\n.callout[data-callout-type=\"warning\"] {\n  --callout-bg: #FEFCE8;\n  --callout-border: #FEF08A;\n  --callout-text: #854D0E;\n}\n.dark .callout[data-callout-type=\"warning\"] {\n  --callout-bg: #CA8A0433;\n  --callout-border: #713F12;\n  --callout-text: #FDE047;\n}\n/* Info — light */\n.callout[data-callout-type=\"info\"] {\n  --callout-bg: #FAFAFA;\n  --callout-border: #E5E5E5;\n  --callout-text: #262626;\n}\n.dark .callout[data-callout-type=\"info\"] {\n  --callout-bg: #FFFFFF1A;\n  --callout-border: #404040;\n  --callout-text: #D4D4D4;\n}\n/* Tip — light */\n.callout[data-callout-type=\"tip\"] {\n  --callout-bg: #F0FDF4;\n  --callout-border: #BBF7D0;\n  --callout-text: #166534;\n}\n.dark .callout[data-callout-type=\"tip\"] {\n  --callout-bg: #16A34A33;\n  --callout-border: #14532D;\n  --callout-text: #86EFAC;\n}\n/* Check — light */\n.callout[data-callout-type=\"check\"] {\n  --callout-bg: #F0FDF4;\n  --callout-border: #BBF7D0;\n  --callout-text: #166534;\n}\n.dark .callout[data-callout-type=\"check\"] {\n  --callout-bg: #16A34A33;\n  --callout-border: #14532D;\n  --callout-text: #86EFAC;\n}\n/* Danger — light */\n.callout[data-callout-type=\"danger\"] {\n  --callout-bg: #FEF2F2;\n  --callout-border: #FECACA;\n  --callout-text: #991B1B;\n}\n.dark .callout[data-callout-type=\"danger\"] {\n  --callout-bg: #DC262633;\n  --callout-border: #7F1D1D;\n  --callout-text: #FCA5A5;\n}\n/* ------------------------------------------------------ */\n/* Apply the variables without changing spacing or layout */\n.callout[data-callout-type] {\n  background-color: var(--callout-bg);\n  border-color: var(--callout-border);\n}\n\n.callout[data-callout-type]\n  [data-component-part=\"callout-content\"],\n.callout[data-callout-type]\n  [data-component-part=\"callout-icon\"] svg {\n  color: var(--callout-text);\n}\n\n/* PAGINATION (PREV/NEXT) */\n/* Pagination colors — light */\n#pagination {\n  /* --pagination-bg: #F9F6F9;\n  --pagination-border: #E5DFE4;\n  --pagination-title: #1D191C;*/\n  --pagination-label: #E551BA; \n  --pagination-arrow: #E551BA;\n}\n.dark #pagination {\n  /* --pagination-bg: #151215;\n  --pagination-border: #302A2F;\n  --pagination-title: #F9F6F9;*/\n  --pagination-label: #E551BA; \n  --pagination-arrow: #E551BA;\n}\n\n/* Previous and Next boxes */\n#pagination [data-component-part=\"pagination-prev\"],\n#pagination [data-component-part=\"pagination-next\"] {\n  /* background-color: var(--pagination-bg) !important; */\n  /* border-color: var(--pagination-border) !important; */\n  /* padding: 1rem 1.25rem; */\n}\n\n/* Page names: Choice and Noul */\n#pagination [data-component-part=\"pagination-title\"] {\n  /* color: var(--pagination-title) !important;\n  font-size: 1rem; */\n  font-weight: 400;\n  opacity: 75%\n\n}\n\n/* Previous and Next labels */\n#pagination [data-component-part=\"pagination-label\"] {\n  color: var(--pagination-label) !important;\n}\n\n/* Arrow icons */\n#pagination [data-component-part=\"pagination-chevron\"] {\n  color: var(--pagination-arrow) !important;\n}\n\n/* Hover state */\n#pagination a:hover {\n  background-color: #F5F0F3;;\n}\n.dark #pagination a:hover {\n  background-color: color-mix(in srgb, #2C272B 60%, transparent);\n\n}\n\n/* ---------------- MERMAID DIAGRAMS ----------------\n   [data-component-name^=\"mermaid-\"] matches both the inline diagram\n   (\"mermaid-container\") and the fullscreen view (\"mermaid-fullscreen-modal\"),\n   which renders a second copy of the SVG outside the container. */\n\n/* Hover controls: keep only the fullscreen button, square everything. */\n[data-component-name=\"mermaid-container\"] \u003e .grid {\n  display: block;\n}\n[data-component-name=\"mermaid-container\"] \u003e .grid \u003e button:not([aria-label=\"Open fullscreen\"]) {\n  display: none;\n}\n[data-component-name^=\"mermaid-\"] button,\n[data-component-name^=\"mermaid-\"] span {\n  border-radius: 0 !important;\n}\n\n/* Touch users need a visible fullscreen button. Put it below the diagram so\n   the larger tap target does not cover nodes in a small preview. */\n@media (max-width: 767px), (hover: none), (pointer: coarse) {\n  [data-component-name=\"mermaid-container\"] {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n  [data-component-name=\"mermaid-container\"] \u003e [data-component-name=\"mermaid-controls-wrapper\"] {\n    position: static;\n    order: 1;\n    align-self: flex-end;\n    opacity: 1;\n    pointer-events: auto;\n  }\n  [data-component-name^=\"mermaid-\"] button {\n    width: 32px;\n    height: 32px;\n    min-width: 32px;\n    min-height: 32px;\n    margin: 6px;\n  }\n  [data-component-name^=\"mermaid-\"] button:not([aria-label=\"Close fullscreen\"]) {\n    position: relative;\n  }\n  /* Extend through the 1px border into the 6px margin: a 44px tap target. */\n  [data-component-name^=\"mermaid-\"] button::after {\n    content: \"\";\n    position: absolute;\n    inset: -7px;\n  }\n}\n\n/* Palette. One accent, the brand pink, marks the TypeSafe boundary: the\n   subgraph and its heading. Everything else is neutral zinc, the same greys\n   the interactive widgets use, so diagrams read like the rest of the page in\n   both themes. Without these rules light mode falls back to mermaid's stock\n   theme (lavender nodes, yellow subgraphs) and dark mode to Mintlify's flat\n   grey theme. Per-diagram classDef colours still win, because mermaid writes\n   them as inline !important styles.\n\n   Contrast (WCAG AA): text is at least 4.5:1 and lines at least 3:1 against\n   the page in each theme. Pink is used for strokes and fills only, never for\n   diagram text: brand pink #E551BA is 3.4:1 on white. */\n[data-component-name^=\"mermaid-\"] {\n  --mermaid-accent: var(--ts-accent);\n  --mermaid-accent-fill: color-mix(in srgb, var(--ts-accent) 7%, transparent);\n  --mermaid-node-fill: #ffffff;\n  --mermaid-node-stroke: #27272a; /* zinc-800, same as node text */\n  --mermaid-text: #27272a;        /* zinc-800 */\n  --mermaid-muted: #52525b;       /* zinc-600, 7.7:1 on white */\n  --mermaid-line: #71717a;        /* zinc-500 */\n  --mermaid-label-bg: rgb(var(--background-light));\n}\n.dark [data-component-name^=\"mermaid-\"] {\n  --mermaid-accent-fill: color-mix(in srgb, var(--ts-accent) 10%, transparent);\n  --mermaid-node-fill: rgb(var(--background-dark)); /* page colour, as white is in light mode */\n  --mermaid-node-stroke: #ffffff;\n  --mermaid-text: #fafafa;        /* zinc-50 */\n  --mermaid-muted: #d4d4d8;       /* zinc-300, edge labels */\n  --mermaid-line: #a1a1aa;\n  --mermaid-label-bg: rgb(var(--background-dark));\n}\n[data-component-name^=\"mermaid-\"] :is(.node rect, .node circle, .node ellipse, .node polygon, .node path) {\n  fill: var(--mermaid-node-fill) !important;\n  stroke: var(--mermaid-node-stroke) !important;\n  stroke-width: 1px !important;\n}\n[data-component-name^=\"mermaid-\"] .cluster rect {\n  fill: var(--mermaid-accent-fill) !important;\n  stroke: var(--mermaid-accent) !important;\n  stroke-width: 1.5px !important;\n}\n[data-component-name^=\"mermaid-\"] :is(.nodeLabel, .nodeLabel p, .label text) {\n  color: var(--mermaid-text) !important;\n  fill: var(--mermaid-text) !important;\n}\n/* The subgraph heading uses the ordinary text colour: the pink border and\n   tint already mark the TypeSafe boundary, and plain text reads better on the\n   tint (13:1 in dark mode) than pink (5.3:1). Do not add font-weight here: a\n   heavier weight would outgrow the box mermaid measured. */\n[data-component-name^=\"mermaid-\"] .cluster-label :is(.nodeLabel, p) {\n  color: var(--mermaid-text) !important;\n}\n/* linkStyle writes a plain inline stroke:none (no !important), so leave those\n   links alone or the !important below would make hidden edges visible. */\n[data-component-name^=\"mermaid-\"] :is(.flowchart-link:not([style*=\"stroke:none\"]), .marker) {\n  stroke: var(--mermaid-line) !important;\n}\n[data-component-name^=\"mermaid-\"] .marker {\n  fill: var(--mermaid-line) !important;\n}\n\n/* Edge labels sit on the arrow, so their background is the page background\n   (Mintlify's own variables) rather than a grey pill. */\n[data-component-name^=\"mermaid-\"] :is(.edgeLabel p, .edgeLabel span) {\n  color: var(--mermaid-muted) !important;\n  background-color: var(--mermaid-label-bg) !important;\n}\n/* Mermaid's dark theme paints the label wrapper a translucent grey. It is a\n   little larger than the span, so it showed as a thin frame around the text. */\n[data-component-name^=\"mermaid-\"] .labelBkg {\n  background-color: var(--mermaid-label-bg) !important;\n}\n[data-component-name^=\"mermaid-\"] .edgeLabel rect {\n  fill: var(--mermaid-label-bg) !important;\n}\n\n/* ---------------- MERMAID: NEON SIGNAL (dark mode only) ----------------\n   Proposed by the TypeSafe team. All rules in this block are under .dark.\n   Light mode gets the same branch colours, in darker shades and without\n   the glow, in the BRANCHES (light mode) block below.\n\n   The palette is pink and neutral. All lines glow: node borders, edges,\n   arrowheads, and the pink TypeSafe subgraph. Decision diamonds get a\n   thicker border. Plain shapes have the page colour as fill.\n\n   Branch colours. A diagram with a routing decision colours the branches\n   after it. Green and red are state colours, reserved for success and\n   error. The other colours are labels. The meaning is the same in every\n   diagram:\n     green  - proceeds to an automated handler (success)\n     red    - error, or not confident enough\n     blue   - goes to a person (human agent, review, confirmation)\n     purple - stops (block, drop, leave unlinked)\n     orange - another automated path, secondary to the main one\n              (billing, crisis support, conflicting evidence)\n   Green marks the branch by where it goes, not by the word on the edge:\n   a \"no\" that proceeds to a handler is green.\n   A confidence gate is different. Its branches read as a gradient in\n   rainbow order: red, orange, yellow, green from the lowest branch to the\n   highest. A gate with more branches continues the rainbow: blue, indigo,\n   violet.\n   A diagram with no confidence test, such as fan-out, is also different.\n   Its branches are categories, not states, so the colours are labels only\n   and it uses no green.\n   In the diagram source, give the node `class \u003cnode\u003e neonGreen`. Give the\n   edge an id with the colour as prefix: `gate green_ok@-- \"yes\" --\u003e ok`.\n   Mermaid writes the edge id on the path and on the label, so one rule per\n   colour covers the node, the edge, the label, and the arrowhead.\n\n   Contrast on the dark page (#0d0a0f): white text 19:1, zinc-200 lines\n   15.5:1, green-400 11.3:1, blue-400 7.7:1, purple-400 8.2:1,\n   orange-400 8.7:1, red-400 7.1:1, yellow-400 12.8:1. */\n.dark [data-component-name^=\"mermaid-\"] {\n  --neon-line: #e4e4e7;   /* zinc-200: node borders and edges */\n  --neon-green: #4ade80;  /* green-400 */\n  --neon-blue: #60a5fa;   /* blue-400 */\n  --neon-purple: #c084fc; /* purple-400 */\n  --neon-yellow: #facc15; /* yellow-400 */\n  --neon-orange: #fb923c; /* orange-400 */\n  --neon-red: #f87171;    /* red-400 */\n  --mermaid-text: #ffffff;\n  --mermaid-muted: #e4e4e7; /* zinc-200, edge labels */\n  --mermaid-line: var(--neon-line);\n}\n.dark [data-component-name^=\"mermaid-\"] :is(.node rect, .node circle, .node ellipse, .node polygon, .node path) {\n  --neon: var(--neon-line);\n  fill: rgb(var(--background-dark)) !important;\n  stroke: var(--neon) !important;\n  stroke-width: 1.5px !important;\n  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 60%, transparent));\n}\n.dark [data-component-name^=\"mermaid-\"] .node polygon {\n  stroke-width: 2px !important;\n  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 60%, transparent));\n}\n/* The TypeSafe subgraph keeps its pink boundary. */\n.dark [data-component-name^=\"mermaid-\"] .cluster rect {\n  fill: color-mix(in srgb, var(--mermaid-accent) 14%, rgb(var(--background-dark))) !important;\n  stroke: var(--mermaid-accent) !important;\n  stroke-width: 1.5px !important;\n  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--mermaid-accent) 55%, transparent));\n}\n/* A subgraph that is not TypeSafe opts out with `style X fill:none,...`.\n   Mermaid writes that inline, so it wins over the fill and stroke above,\n   but not over the filter. Drop the pink glow too. */\n.dark [data-component-name^=\"mermaid-\"] .cluster rect[style*=\"fill:none\"] {\n  filter: none;\n}\n/* All edges glow. linkStyle hides some edges with an inline stroke:none. */\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link:not([style*=\"stroke:none\"]) {\n  --neon: var(--neon-line);\n  stroke: var(--neon) !important;\n  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--neon) 55%, transparent));\n}\n/* Arrowheads take the colour of their edge. Browsers without\n   context-stroke keep the plain line colour. */\n.dark [data-component-name^=\"mermaid-\"] .marker {\n  fill: var(--mermaid-line) !important;\n  stroke: var(--mermaid-line) !important;\n  fill: context-stroke !important;\n  stroke: context-stroke !important;\n}\n/* Branches: node classes, edge id prefixes, and edge labels.\n   Branch shapes get a light tint of their colour. */\n.dark [data-component-name^=\"mermaid-\"] .node.neonGreen :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-green); }\n.dark [data-component-name^=\"mermaid-\"] .node.neonBlue :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-blue); }\n.dark [data-component-name^=\"mermaid-\"] .node.neonPurple :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-purple); }\n.dark [data-component-name^=\"mermaid-\"] .node.neonYellow :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-yellow); }\n.dark [data-component-name^=\"mermaid-\"] .node.neonOrange :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-orange); }\n.dark [data-component-name^=\"mermaid-\"] .node.neonRed :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-red); }\n.dark [data-component-name^=\"mermaid-\"] :is(.node.neonGreen, .node.neonBlue, .node.neonPurple, .node.neonYellow, .node.neonOrange, .node.neonRed) :is(rect, circle, ellipse, polygon, path) {\n  fill: color-mix(in srgb, var(--neon) 12%, rgb(var(--background-dark))) !important;\n}\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-green_\"] { --neon: var(--neon-green); }\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-blue_\"] { --neon: var(--neon-blue); }\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-purple_\"] { --neon: var(--neon-purple); }\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-yellow_\"] { --neon: var(--neon-yellow); }\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-orange_\"] { --neon: var(--neon-orange); }\n.dark [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-red_\"] { --neon: var(--neon-red); }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"green_\"] .edgeLabel p { color: var(--neon-green) !important; }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"blue_\"] .edgeLabel p { color: var(--neon-blue) !important; }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"purple_\"] .edgeLabel p { color: var(--neon-purple) !important; }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"yellow_\"] .edgeLabel p { color: var(--neon-yellow) !important; }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"orange_\"] .edgeLabel p { color: var(--neon-orange) !important; }\n.dark [data-component-name^=\"mermaid-\"] .label[data-id^=\"red_\"] .edgeLabel p { color: var(--neon-red) !important; }\n\n/* ---------------- MERMAID: BRANCHES (light mode) ----------------\n   The same branch colours and meanings as the dark-mode block, in darker\n   shades. No glow: it looks wrong on white.\n\n   Contrast on white (WCAG AA, 4.5:1 for label text): green-700 5.0:1,\n   green-700 5.0:1, blue-700 6.7:1, purple-700 7.0:1, orange-700 5.2:1,\n   red-700 6.5:1, yellow-700 4.9:1. */\n:root:not(.dark) [data-component-name^=\"mermaid-\"] {\n  --neon-green: #15803d;  /* green-700 */\n  --neon-blue: #1d4ed8;   /* blue-700 */\n  --neon-purple: #7e22ce; /* purple-700 */\n  --neon-yellow: #a16207; /* yellow-700 */\n  --neon-orange: #c2410c; /* orange-700 */\n  --neon-red: #b91c1c;    /* red-700 */\n}\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonGreen :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-green); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonBlue :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-blue); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonPurple :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-purple); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonYellow :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-yellow); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonOrange :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-orange); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .node.neonRed :is(rect, circle, ellipse, polygon, path) { --neon: var(--neon-red); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] :is(.node.neonGreen, .node.neonBlue, .node.neonPurple, .node.neonYellow, .node.neonOrange, .node.neonRed) :is(rect, circle, ellipse, polygon, path) {\n  fill: color-mix(in srgb, var(--neon) 7%, #ffffff) !important;\n  stroke: var(--neon) !important;\n  stroke-width: 1.5px !important;\n}\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-green_\"] { --neon: var(--neon-green); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-blue_\"] { --neon: var(--neon-blue); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .flowchart-link[id*=\"-purple_\"] { --neon: var(--neon-purple); }\n:root:not(.dark) [data-component-name^=\"mermaid-\"] .flowchart-