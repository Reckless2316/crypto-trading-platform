}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!_MdxComponentBoundary)_missingMdxReference(`_MdxComponentBoundary`,true);return _jsxs(_Fragment,{children:[_jsxs(_components.p,{children:[`All Score and Choice answers from TypeSafe include a `,_jsx(_components.code,{children:`probabilities`}),` property representing the probability distribution across the options (for Choice) or levels (for Score). The `,_jsx(_components.em,{children:`shape`}),` of that distribution is what tells you how certain the model is: concentrated on one outcome means a confident answer, spread out means an uncertain one.`]}),`\n`,_jsxs(_components.p,{children:[`The answer’s `,_jsx(_components.code,{children:`confidence`}),` property collapses that shape into a single number from 0 to 1, so you can threshold on it without doing the math yourself. It is 1 when all the probability is on one outcome and 0 when the probability is spread evenly. (Noul answers don’t carry one; see `,_jsx(_components.a,{href:`#noul`,children:`Noul`}),` below.)`]}),`\n`,_jsx(Heading,{level:`2`,id:`confidence-is-derived-from-the-probabilities`,children:`Confidence is derived from the probabilities`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`confidence`}),` is a statistic computed from the probability distribution the answer already gives you. TypeSafe computes it for you and returns it on every Choice and Score answer, so the common case needs no extra work on your side.`]}),`\n`,_jsx(_MdxComponentBoundary,{name:`ConfidenceExplorer`,children:_jsx(ConfidenceExplorer,{})}),`\n`,_jsxs(_components.p,{children:[`For a `,_jsx(_components.a,{href:`/primitives/choice`,children:`Choice`}),`, the distribution is `,_jsx(_components.code,{children:`probabilities`}),` across your options. For a `,_jsx(_components.a,{href:`/primitives/score`,children:`Score`}),`, it is the distribution across your levels. In both cases a flatter distribution means lower confidence: low confidence on a Choice often means none of the options are a clear winner over the others, and low confidence on a Score often means the levels are ambiguous, multi-dimensional, or the state doesn’t contain enough to go on.`]}),`\n`,_jsxs(_components.p,{children:[`The exact formula for each question type is in `,_jsx(_components.a,{href:`#how-confidence-is-calculated`,children:`How confidence is calculated`}),`, so you can see how any `,_jsx(_components.code,{children:`confidence`}),` value follows from the answer’s own `,_jsx(_components.code,{children:`probabilities`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`”i-don’t-know”-is-a-useful-signal`,children:`”I don’t know” is a useful signal`}),`\n`,_jsx(_components.p,{children:`If an intelligent system, whether human or machine, cannot express honest uncertainty, the system cannot be trusted.`}),`\n`,_jsx(_components.p,{children:`Confidence gives you a built-in mechanism for the model to say “I’m not sure about this one.” This lets your code implement different behavior for different levels of certainty, which is the foundation for building systems you can actually rely on.`}),`\n`,_jsx(Heading,{level:`2`,id:`three-paths-for-using-confidence-in-your-code`,children:`Three paths for using confidence in your code`}),`\n`,_jsx(_components.p,{children:`A useful starting pattern is to divide confidence into three ranges, each producing a different system behavior:`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`High confidence:`}),` Act automatically. The model has a clear read and you can proceed without human involvement.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Medium confidence:`}),` Proceed with caution. The model has a reasonable answer but is not certain. Depending on context, you might ask the user to confirm, flag for review, or gather more information before acting.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Low confidence:`}),` Do not act. Route to a human, request clarification, or fall back to a different system. The model is telling you it does not have enough information or the question is not a good fit.`]}),`\n`,_jsx(_components.p,{children:`Where you draw those boundaries depends on the stakes.`}),`\n`,_jsx(Heading,{level:`2`,id:`thresholds-scale-with-risk`,children:`Thresholds scale with risk`}),`\n`,_jsx(_components.p,{children:`A confidence threshold is not one number. Different actions within the same system should be gated at different levels depending on the consequences of getting it wrong.`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`32`,language:`python`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`python`,children:_jsxs(_components.code,{language:`python`,numberOfLines:`32`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`response `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` client.system_one(`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#9CDCFE`},children:`    state`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`user_message,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#9CDCFE`},children:`    questions`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.s